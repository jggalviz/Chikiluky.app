---
import LayoutBase from '../../../layouts/LayoutBase.astro';
import ClientDashboard from '../../../islands/ClientDashboard';
import { getSession } from '../../../lib/session.ts';

const { user, perfil } = await getSession(Astro.request);

// Redirigir a la landing si no hay sesión activa
if (!user) {
  return Astro.redirect('/');
}

const isPro = perfil && ['experto', 'administrador'].includes(perfil.role);
---
<LayoutBase title="Mi Escritorio — CHIKILUKY" description="Gestiona tus citas de belleza, revisa tus mensajes y edita tu perfil.">
  
  <!-- CABECERA PREMIUM (CON DROPDOWN DINÁMICO DE LUJO) -->
  <header style="position:sticky;top:0;z-index:40;display:flex;align-items:center;justify-content:space-between;padding:0.9rem 1.5rem;background:rgba(10,10,10,0.95);backdrop-filter:blur(14px);border-bottom:1px solid #262626">
    <a href="/" style="text-decoration:none">
      <span class="brand-text" style="font-size:1.1rem;color:#ba8f57">CHIKILUKY</span> 
      <span style="font-family:'Montserrat',sans-serif;font-weight:300;font-style:normal;font-size:0.6rem;color:#555;letter-spacing:0.1em;text-transform:uppercase">{isPro ? '.pro' : '.app'}</span>
    </a>
    
    <nav style="display:flex;align-items:center;gap:0.4rem">
      {perfil && (
        <div style="display:flex;align-items:center;gap:0.45rem;padding:0.35rem 0.75rem;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.05);border-radius:0px;margin-right:0.2rem">
          <span style="width:6px;height:6px;background:#ba8f57;border-radius:50%;box-shadow:0 0 4px #ba8f57"></span>
          <span style="font-family:'Urbanist',sans-serif;font-size:0.76rem;color:#eee;font-weight:700;letter-spacing:0.02em">{perfil.full_name}</span>
        </div>
      )}
      
      {/* Botón dinámico 'Mi Panel' / Dropdown de Esquinas Rectas */}
      <div class="dropdown-container">
        <button class="dropdown-trigger" style="font-family:'Urbanist',sans-serif;font-size:0.8rem;font-weight:700;color:#ba8f57;text-decoration:none;padding:0.35rem 0.75rem;border-radius:0px;background:rgba(186,143,87,0.06);border:1px solid rgba(186,143,87,0.15);cursor:pointer">
          Mi Panel ▼
        </button>
        <div class="dropdown-menu">
          <a href="/app/cliente/escritorio#reservas" class="dropdown-item">Mis Reservas</a>
          <a href="/app/cliente/escritorio#chats" class="dropdown-item">Mensajes / Chats</a>
          <a href="/app/cliente/escritorio#perfil" class="dropdown-item">Configurar Perfil</a>
          <a href="/app/cliente/buscar" class="dropdown-item">Buscar Salón</a>
          {isPro && (
            <a href="/app/experto/escritorio" class="dropdown-item" style="border-top: 1px solid rgba(186,143,87,0.15); color: #ba8f57;">Panel Pro</a>
          )}
          <a href="/api/auth/logout" class="dropdown-item" style="border-top:1px solid rgba(255,255,255,0.05)">Cerrar Sesión</a>
        </div>
      </div>
      
      <span style="color:#262626;margin:0 0.2rem">|</span>
      <a href="/api/auth/logout" style="font-family:'Urbanist',sans-serif;font-size:0.76rem;font-weight:700;color:#ba8f57;border:1px solid rgba(186,143,87,0.25);padding:0.35rem 0.9rem;border-radius:0px;text-decoration:none" onmouseover="this.style.background='rgba(186,143,87,0.06)'" onmouseout="this.style.background='transparent'">Salir</a>
    </nav>
  </header>

  <!-- SECCIÓN DE CONTENIDO PRINCIPAL -->
  <div style="max-width:1200px;width:100%;margin:2.5rem auto;padding:0 1.5rem;box-sizing:border-box;flex:1">
    <div style="margin-bottom:2rem">
      <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:0.7rem;letter-spacing:0.16em;color:#ba8f57;text-transform:uppercase;margin-bottom:0.4rem">Ecosistema de imagen y cuidado personal</p>
      <h1 style="font-family:'Oswald',sans-serif;font-weight:700;font-size:clamp(1.6rem,4vw,2.2rem);color:#fff;margin:0;letter-spacing:0.02em">Panel de Control</h1>
    </div>
    
    {/* Carga del componente interactivo de Preact */}
    <ClientDashboard clientUser={user} clientPerfil={perfil} client:load />
  </div>

  <!-- ESTILOS DEL DROPDOWN DE LUJO -->
  <style>
    .dropdown-container {
      position: relative;
      display: inline-block;
    }
    .dropdown-trigger:hover {
      background: rgba(186,143,87,0.12) !important;
    }
    .dropdown-menu {
      display: none;
      position: absolute;
      right: 0;
      top: 100%;
      background: rgba(10, 10, 10, 0.98);
      border: 1px solid #ba8f57;
      min-width: 190px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.85);
      z-index: 50;
      border-radius: 0px; /* Estilo esquinas rectas */
      margin-top: 2px;
      backdrop-filter: blur(8px);
    }
    .dropdown-container:hover .dropdown-menu {
      display: block;
    }
    .dropdown-item {
      color: #a3a3a3;
      padding: 0.7rem 1.1rem;
      text-decoration: none;
      display: block;
      font-family: 'Urbanist', sans-serif;
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      transition: all 0.2s ease;
      border-bottom: 1px solid rgba(255,255,255,0.02);
    }
    .dropdown-item:hover {
      background: rgba(186, 143, 87, 0.06);
      color: #ba8f57;
    }
    .dropdown-item:last-child {
      border-bottom: none;
    }
  </style>

</LayoutBase>
