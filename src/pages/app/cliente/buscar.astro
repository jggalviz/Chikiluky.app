---
import LayoutBase from '../../../layouts/LayoutBase.astro';
import { supabase } from '../../../lib/supabase.js';
import { getSession } from '../../../lib/session.js';

const { user, perfil } = await getSession(Astro.request);
if (!user) return Astro.redirect('/');

// ── Consulta SSR: todos los negocios ─────────────────────────────────────────
const { data: negocios, error: negociosError } = await supabase
  .from('negocios')
  .select('id, name, descripcion, address, categoria')
  .order('name', { ascending: true });

const categorias = [
  'Todos',
  'Peluquería',
  'Barbería',
  'Uñas',
  'Estética y Cejas',
  'Masajes y Spa',
  'Maquillaje',
  'Tatuajes',
  'Depilación',
  'Podología',
];
---

<LayoutBase
  title="Buscar Salón — CHIKILUKY"
  description="Encuentra y agenda tu cita en barberías y salones de Caracas."
>

  <!-- ═══════════════════════════════════════
       HEADER DE NAVEGACIÓN
  ════════════════════════════════════════ -->
  <header style="position:sticky;top:0;z-index:40;display:flex;align-items:center;justify-content:space-between;padding:0.9rem 1.5rem;background:rgba(10,10,10,0.95);backdrop-filter:blur(14px);border-bottom:1px solid #262626">
    <a href="/app/cliente/buscar" style="text-decoration:none">
      <span class="brand-text" style="font-size:1.1rem;color:#ba8f57">CHIKILUKY</span> 
      <span style="font-family:'Montserrat',sans-serif;font-weight:300;font-style:normal;font-size:0.6rem;color:#555;letter-spacing:0.1em;text-transform:uppercase">{perfil && ['experto','administrador'].includes(perfil.role) ? '.pro' : '.app'}</span>
    </a>
    <nav style="display:flex;align-items:center;gap:0.4rem">
      {perfil && (
        <div style="display:flex;align-items:center;gap:0.45rem;padding:0.35rem 0.75rem;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.05);border-radius:0px;margin-right:0.2rem" class="header-user-badge">
          <span style="width:6px;height:6px;background:#ba8f57;border-radius:50%;box-shadow:0 0 4px #ba8f57"></span>
          <span style="font-family:'Urbanist',sans-serif;font-size:0.76rem;color:#eee;font-weight:700;letter-spacing:0.02em">{perfil.full_name}</span>
        </div>
      )}
      
      {perfil && (
        <div class="dropdown-container">
          <button class="dropdown-trigger" style="font-family:'Urbanist',sans-serif;font-size:0.8rem;font-weight:700;color:#ba8f57;text-decoration:none;padding:0.35rem 0.75rem;border-radius:0px;background:rgba(186,143,87,0.06);border:1px solid rgba(186,143,87,0.15);cursor:pointer">
            Mi Panel ▼
          </button>
          <div class="dropdown-menu">
            <a href="/app/cliente/escritorio#reservas" class="dropdown-item">Mis Reservas</a>
            <a href="/app/cliente/escritorio#chats" class="dropdown-item">Mensajes / Chats</a>
            <a href="/app/cliente/escritorio#perfil" class="dropdown-item">Configurar Perfil</a>
            <a href="/app/cliente/buscar" class="dropdown-item">Buscar Salón</a>
            {['experto','administrador'].includes(perfil.role) && (
              <a href="/app/experto/escritorio" class="dropdown-item" style="border-top: 1px solid rgba(186,143,87,0.15); color: #ba8f57;">Panel Pro</a>
            )}
            <a href="/api/auth/logout" class="dropdown-item" style="border-top:1px solid rgba(255,255,255,0.05)">Cerrar Sesión</a>
          </div>
        </div>
      )}

      <span style="color:#262626;margin:0 0.2rem">|</span>
      <a href="/api/auth/logout" style="font-family:'Urbanist',sans-serif;font-size:0.76rem;font-weight:700;color:#ba8f57;border:1px solid rgba(186,143,87,0.25);padding:0.35rem 0.9rem;border-radius:0px;text-decoration:none" onmouseover="this.style.background='rgba(186,143,87,0.06)'" onmouseout="this.style.background='transparent'">Salir</a>
    </nav>
  </header>

  <!-- ESTILOS LOCALES PARA EL DROPDOWN DE LUJO -->
  <style>
    .dropdown-container {
      position: relative;
      display: inline-block;
    }
    .dropdown-trigger:hover {
      background: rgba(186,143,87,0.12) !important;
    }
    .dropdown-menu {
      display: none;
      position: absolute;
      right: 0;
      top: 100%;
      background: rgba(10, 10, 10, 0.98);
      border: 1px solid #ba8f57;
      min-width: 190px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.85);
      z-index: 50;
      border-radius: 0px;
      margin-top: 2px;
      backdrop-filter: blur(8px);
    }
    .dropdown-container:hover .dropdown-menu {
      display: block;
    }
    .dropdown-item {
      color: #a3a3a3;
      padding: 0.7rem 1.1rem;
      text-decoration: none;
      display: block;
      font-family: 'Urbanist', sans-serif;
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      transition: all 0.2s ease;
      border-bottom: 1px solid rgba(255,255,255,0.02);
    }
    .dropdown-item:hover {
      background: rgba(186, 143, 87, 0.06);
      color: #ba8f57;
    }
    .dropdown-item:last-child {
      border-bottom: none;
    }
    @media (max-width: 480px) {
      .header-user-badge {
        display: none !important;
      }
    }
  </style>

  <!-- ═══════════════════════════════════════
       HERO DE BÚSQUEDA
  ════════════════════════════════════════ -->
  <section style="padding:3.5rem 1.5rem 2.5rem;text-align:center;background:#0a0a0a;border-bottom:1px solid #1a1a1a">
    <p style="font-size:0.68rem;font-family:'Urbanist',sans-serif;font-weight:bold;letter-spacing:0.18em;color:#ba8f57;text-transform:uppercase;margin-bottom:0.6rem">Disponible ahora</p>
    <h1 style="font-family:'Urbanist',sans-serif;font-weight:900;font-size:clamp(1.6rem,4vw,2.4rem);color:#fff;margin:0 0 2rem;letter-spacing:-0.02em">
      ¿A qué salón vas hoy?
    </h1>

    <!-- Barra de búsqueda + filtro de categoría -->
    <div style="display:flex;flex-direction:column;gap:0.75rem;max-width:580px;margin:0 auto" class="search-bar">
      <div style="position:relative">
        <span style="position:absolute;left:1rem;top:50%;transform:translateY(-50%);color:#ba8f57;pointer-events:none;display:flex;align-items:center">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </span>
        <input
          id="input-busqueda"
          type="search"
          placeholder="Busca por nombre o dirección…"
          oninput="filtrarNegocios()"
          style="
            width:100%;padding:0.9rem 1rem 0.9rem 2.8rem;
            background:#050505;
            border:1px solid #262626;
            border-radius:0px;
            color:#fff;
            font-family:'Lato',sans-serif;font-size:0.92rem;
            outline:none;box-sizing:border-box;
          "
          onfocus="this.style.borderColor='#ba8f57'"
          onblur="this.style.borderColor='#262626'"
        />
      </div>

      <!-- Filtros de categoría minimalista — scroll horizontal suave con flechas de navegación -->
      <div class="filtros-wrapper">
        <button class="scroll-arrow left-arrow" id="buscar-arrow-left" onclick="scrollBuscarMenu(-200)" aria-label="Desplazar izquierda">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <div id="filtros-cat" class="filtros-scroll">
          <div id="sentinel-start-buscar" style="width: 1px; flex-shrink: 0;"></div>
          {categorias.map((cat) => (
            <button
              data-cat={cat}
              onclick="seleccionarCategoria(this)"
              class={`cat-btn ${cat === 'Todos' ? 'active' : ''}`}
            >
              {cat}
            </button>
          ))}
          <div id="sentinel-end-buscar" style="width: 1px; flex-shrink: 0;"></div>
        </div>

        <button class="scroll-arrow right-arrow" id="buscar-arrow-right" onclick="scrollBuscarMenu(200)" aria-label="Desplazar derecha">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       LISTA DE NEGOCIOS (SSR) - UNA SOLA COLUMNA
  ════════════════════════════════════════ -->
  <main style="padding:2.5rem 1.5rem 5rem;background:#ffffff;flex:1">
    <div class="max-w-6xl mx-auto">

      {negociosError && (
        <p style="text-align:center;color:#ef4444;font-family:'Urbanist',sans-serif;font-size:0.9rem;padding:2rem">
          Error al cargar los salones. Intenta de nuevo más tarde.
        </p>
      )}

      {(!negocios || negocios.length === 0) && !negociosError && (
        <div style="text-align:center;padding:5rem 1rem;border:1px solid #e5e5e5;background:#f9f9f9;border-radius:0px;max-width:800px;margin:0 auto">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#737373" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin:0 auto 1.25rem;display:block">
            <rect x="2" y="7" width="20" height="14" rx="0" ry="0"></rect>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
          </svg>
          <p style="font-family:'Urbanist',sans-serif;font-weight:900;font-size:1rem;color:#171717;margin:0 0 0.35rem 0;text-transform:uppercase;letter-spacing:0.04em">
            Aún no hay salones registrados
          </p>
          <p style="font-family:'Lato',sans-serif;font-size:0.83rem;color:#737373;margin:0">
            ¿Tienes un negocio? <a href="/" style="color:#ba8f57;text-decoration:none;font-weight:bold">Regístralo aquí</a>
          </p>
        </div>
      )}

      <!-- Lista de tarjetas de una sola columna -->
      <div id="grid-negocios" style="
        display:flex;
        flex-direction:column;
        gap:0.75rem;
        max-width:800px;
        margin:0 auto;
      ">
        {negocios?.map((negocio) => (
          <article
            data-nombre={negocio.name.toLowerCase()}
            data-cat={negocio.categoria ?? 'Otros'}
            class="negocio-card"
          >
            <!-- Info del negocio -->
            <div class="negocio-info">
              <!-- Top Row: Badge de Categoría + Caracas -->
              <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap">
                <span style="
                  font-family:'Urbanist',sans-serif;font-size:0.68rem;font-weight:900;
                  letter-spacing:0.08em;text-transform:uppercase;
                  color:#ba8f57;background:rgba(186,143,87,0.06);
                  border:1px solid rgba(186,143,87,0.15);
                  padding:0.25rem 0.65rem;border-radius:0px;
                ">
                  {negocio.categoria ?? 'Salón'}
                </span>
                <span style="font-size:0.72rem;color:#737373;font-family:'Lato',sans-serif;display:inline-flex;align-items:center;gap:0.25rem">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                  Caracas
                </span>
              </div>

              <!-- Nombre -->
              <h2 style="font-family:'Urbanist',sans-serif;font-weight:900;font-size:1.15rem;color:#171717;line-height:1.2;margin:0.25rem 0 0.15rem 0;text-transform:uppercase;letter-spacing:0.02em">
                {negocio.name}
              </h2>

              <!-- Descripción -->
              {negocio.descripcion && (
                <p style="font-family:'Lato',sans-serif;font-size:0.83rem;color:#525252;line-height:1.5;margin:0">
                  {negocio.descripcion}
                </p>
              )}

              <!-- Dirección -->
              {negocio.address && (
                <p style="font-family:'Lato',sans-serif;font-size:0.76rem;color:#737373;margin:0.2rem 0 0 0;display:flex;align-items:center;gap:0.3rem">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:#ba8f57">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="16"></line>
                    <line x1="8" y1="12" x2="16" y2="12"></line>
                  </svg>
                  {negocio.address}
                </p>
              )}
            </div>

            <!-- CTA -->
            <div class="negocio-cta">
              <a
                href={`/app/cliente/reservar?id=${negocio.id}`}
                class="cta-btn-link"
              >
                Ver Agenda →
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Mensaje sin resultados de búsqueda (JS) -->
      <p id="sin-resultados" style="display:none;text-align:center;color:#737373;font-family:'Lato',sans-serif;font-size:0.9rem;padding:3rem">
        No se encontraron salones con ese criterio.
      </p>
    </div>
  </main>

  <!-- ═══════════════════════════════════════
       SCRIPT: Filtro cliente (< 1 KB)
  ════════════════════════════════════════ -->
  <script is:inline>
    let catActiva = 'Todos';

    window.seleccionarCategoria = function(btn) {
      catActiva = btn.dataset.cat;
      document.querySelectorAll('#filtros-cat .cat-btn').forEach(b => {
        if (b === btn) {
          b.classList.add('active');
        } else {
          b.classList.remove('active');
        }
      });
      filtrarNegocios();
    };

    window.filtrarNegocios = function() {
      const q       = document.getElementById('input-busqueda').value.toLowerCase();
      const tarjetas = document.querySelectorAll('#grid-negocios article');
      let visibles  = 0;

      tarjetas.forEach(card => {
        const nombre  = card.dataset.nombre ?? '';
        const cat     = card.dataset.cat    ?? '';
        const matchQ  = nombre.includes(q);
        const matchC  = catActiva === 'Todos' || cat === catActiva;
        const visible = matchQ && matchC;
        card.style.display = visible ? '' : 'none';
        if (visible) visibles++;
      });

      document.getElementById('sin-resultados').style.display = visibles === 0 ? 'block' : 'none';
    };

    // Auto-seleccionar categoría desde la URL al inicializar
    window.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const catParam = urlParams.get('cat');
      if (catParam) {
        const btn = document.querySelector(`#filtros-cat button[data-cat="${catParam}"]`);
        if (btn) {
          window.seleccionarCategoria(btn);
        }
      }
    });

    // ── Funciones de Desplazamiento de Categorías con Flechas ──
    window.scrollBuscarMenu = function(val) {
      const scrollCont = document.getElementById('filtros-cat');
      if (scrollCont) {
        scrollCont.scrollBy({ left: val, behavior: 'smooth' });
      }
    };

    window.addEventListener('DOMContentLoaded', () => {
      const scrollCont = document.getElementById('filtros-cat');
      const arrowL = document.getElementById('buscar-arrow-left');
      const arrowR = document.getElementById('buscar-arrow-right');
      const sentinelStart = document.getElementById('sentinel-start-buscar');
      const sentinelEnd = document.getElementById('sentinel-end-buscar');

      if (scrollCont && arrowL && arrowR && sentinelStart && sentinelEnd) {
        // Observer para la izquierda (oculta flecha si el sentinel de inicio es visible)
        const observerStart = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              arrowL.classList.remove('visible');
            } else {
              arrowL.classList.add('visible');
            }
          });
        }, { root: scrollCont, threshold: 0.1 });

        // Observer para la derecha (oculta flecha si el sentinel del final es visible)
        const observerEnd = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              arrowR.classList.remove('visible');
            } else {
              arrowR.classList.add('visible');
            }
          });
        }, { root: scrollCont, threshold: 0.1 });

        observerStart.observe(sentinelStart);
        observerEnd.observe(sentinelEnd);
      }
    });
  </script>

</LayoutBase>

<style>
  @media (min-width: 640px) {
    .sm-show { display: inline !important; }
  }

  /* ── Filtros Minimalistas: menú horizontal elegante ── */
  .filtros-wrapper {
    position: relative;
    width: 100%;
    max-width: 900px;
    margin: 1.5rem auto 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Fades laterales indicando que hay más contenido en scroll horizontal */
  .filtros-wrapper::before,
  .filtros-wrapper::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2.5rem;
    z-index: 2;
    pointer-events: none;
  }
  .filtros-wrapper::before {
    left: 0;
    background: linear-gradient(to right, #0a0a0a, transparent);
  }
  .filtros-wrapper::after {
    right: 0;
    background: linear-gradient(to left, #0a0a0a, transparent);
  }

  .filtros-scroll {
    display: flex;
    gap: 1.75rem;
    overflow-x: auto;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding: 0 2rem;
    scrollbar-width: none; /* Firefox */
  }
  .filtros-scroll::-webkit-scrollbar { display: none; } /* Chrome/Safari */

  /* Botones minimalistas de categoría */
  .cat-btn {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: rgba(255, 255, 255, 0.45);
    padding: 0.75rem 0.1rem;
    font-family: 'Urbanist', sans-serif;
    font-weight: 500;
    font-size: 0.92rem;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    white-space: nowrap;
    letter-spacing: 0.01em;
  }
  .cat-btn:hover {
    color: rgba(255, 255, 255, 0.95);
  }
  .cat-btn.active {
    color: #ffffff;
    border-bottom-color: #ba8f57;
    font-weight: 600;
  }

  /* Flechas de desplazamiento lateral ultra premium */
  .scroll-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 30px;
    height: 30px;
    border-radius: 0px;
    background: #0a0a0a;
    border: 1px solid #262626;
    color: rgba(255, 255, 255, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: all 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0;
    pointer-events: none;
    box-shadow: none;
  }
  .scroll-arrow:hover {
    background: rgba(186,143,87,0.06);
    color: #ba8f57;
    border-color: #ba8f57;
  }
  .scroll-arrow.visible {
    opacity: 1;
    pointer-events: auto;
  }
  .scroll-arrow.left-arrow {
    left: -12px;
  }
  .scroll-arrow.right-arrow {
    right: -12px;
  }

  /* Tarjetas en lista de una sola columna */
  .negocio-card {
    background: #ffffff;
    border: 1px solid #e5e5e5;
    border-radius: 0px;
    padding: 1.5rem;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px -1px rgba(0, 0, 0, 0.01);
  }
  .negocio-card:hover {
    border-color: #ba8f57;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.04), 0 4px 6px -2px rgba(0, 0, 0, 0.02);
  }
  .negocio-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }
  .negocio-cta {
    flex-shrink: 0;
  }
  .cta-btn-link {
    display: block;
    background: #ba8f57;
    color: #000;
    font-family: 'Urbanist', sans-serif;
    font-weight: 900;
    font-size: 0.78rem;
    padding: 0.75rem 1.5rem;
    border-radius: 0px;
    text-align: center;
    text-decoration: none;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: all 0.2s;
  }
  .cta-btn-link:hover {
    background: #fff;
  }
  @media (max-width: 640px) {
    .negocio-card {
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
    }
    .cta-btn-link {
      width: 100%;
      box-sizing: border-box;
    }
  }
</style>
