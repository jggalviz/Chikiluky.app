---
import LayoutBase from '../../../layouts/LayoutBase.astro';
import { supabase } from '../../../lib/supabase.js';
import CalendarioReservas from '../../../islands/CalendarioReservas.jsx';

// ── Validación de sesión ──────────────────────────────────────────────────────
const authHeader = Astro.request.headers.get('cookie') ?? '';
const token = authHeader.match(/sb-access-token=([^;]+)/)?.[1];

const { data: { user } } = token
  ? await supabase.auth.getUser(token)
  : { data: { user: null } };

if (!user) return Astro.redirect('/');

// ── Parámetro de URL ──────────────────────────────────────────────────────────
const negocioId = Astro.url.searchParams.get('id');
if (!negocioId) return Astro.redirect('/app/cliente/buscar');

// ── Consultas paralelas SSR ───────────────────────────────────────────────────
const [
  { data: negocio, error: negocioError },
  { data: servicios },
  { data: configData }
] = await Promise.all([
  supabase
    .from('negocios')
    .select('id, name, address, categoria, descripcion, telefono')
    .eq('id', negocioId)
    .single(),
  supabase
    .from('servicios')
    .select('id, nombre, duracion_min, precio_usd, precio_bs')
    .eq('negocio_id', negocioId)
    .order('precio_usd', { ascending: true }),
  supabase
    .from('configuracion_sistema')
    .select('tasa_bcv')
    .eq('id', 1)
    .maybeSingle()
]);

const tasaBcv = configData?.tasa_bcv ? parseFloat(configData.tasa_bcv) : 40.00;

if (negocioError || !negocio) return Astro.redirect('/app/cliente/buscar');

const iconoCategoria: Record<string, string> = {
  'Peluquería': '💇', 'Barbería': '✂️', 'Uñas': '💅',
  'Estética y Cejas': '👁️', 'Masajes y Spa': '🧖',
  'Maquillaje': '💄', 'Tatuajes': '🖋️', 'Depilación': '✨', 'Podología': '🦶',
};
---

<LayoutBase
  title={`Reservar en ${negocio.name}`}
  description={`Agenda tu cita en ${negocio.name}, ${negocio.address ?? 'Caracas'}.`}
>

  <!-- ═══════════════════════════════════════
       HEADER
  ════════════════════════════════════════ -->
  <header style="position:sticky;top:0;z-index:40;display:flex;align-items:center;justify-content:space-between;padding:0.9rem 1.5rem;background:rgba(17,17,17,0.92);backdrop-filter:blur(14px);border-bottom:1px solid rgba(186,143,87,0.15)">
    <a href="/app/cliente/buscar" style="text-decoration:none"><span class="brand-text" style="font-size:1.1rem;color:#ba8f57">CHIKILUKY</span> <span style="font-family:'Montserrat',sans-serif;font-weight:300;font-style:normal;font-size:0.6rem;color:#666;letter-spacing:0.12em;text-transform:uppercase">.app</span></a>
    <nav style="display:flex;align-items:center;gap:0.5rem">
      <a href="/app/cliente/buscar" style="font-family:'Urbanist',sans-serif;font-size:0.8rem;font-weight:600;color:#555;text-decoration:none;padding:0.3rem 0.6rem" onmouseover="this.style.color='#ba8f57'" onmouseout="this.style.color='#555'">← Buscar</a>
      <span style="color:#2a2a2a">|</span>
      <a href="/api/auth/logout" style="font-family:'Urbanist',sans-serif;font-size:0.78rem;font-weight:700;color:#ba8f57;border:1px solid rgba(186,143,87,0.35);padding:0.35rem 0.9rem;border-radius:9999px;text-decoration:none" onmouseover="this.style.background='rgba(186,143,87,0.1)'" onmouseout="this.style.background='transparent'">Salir</a>
    </nav>
  </header>

  <!-- ═══════════════════════════════════════
       FICHA DEL NEGOCIO (SSR estático)
  ════════════════════════════════════════ -->
  <section style="padding:2rem 1.5rem 1.5rem;background:#111;border-bottom:1px solid rgba(186,143,87,0.1)">
    <div style="max-width:680px;margin:0 auto">

      <!-- Badge categoría -->
      <span style="
        display:inline-block;
        font-family:'Urbanist',sans-serif;font-size:0.7rem;font-weight:700;
        letter-spacing:0.1em;text-transform:uppercase;
        color:#ba8f57;background:rgba(186,143,87,0.1);
        padding:0.2rem 0.7rem;border-radius:9999px;margin-bottom:0.75rem;
      ">
        {iconoCategoria[negocio.categoria] ?? '🏪'} {negocio.categoria ?? 'Salón'}
      </span>

      <h1 style="font-family:'Urbanist',sans-serif;font-weight:900;font-size:clamp(1.4rem,4vw,2rem);color:#fff;margin:0 0 0.4rem">
        {negocio.name}
      </h1>

      {negocio.address && (
        <p style="font-family:'Lato',sans-serif;font-size:0.85rem;color:#666;margin:0;display:flex;align-items:center;gap:0.4rem">
          <span style="color:#ba8f57">📌</span> {negocio.address}
        </p>
      )}
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       ISLA DE PREACT — Calendario interactivo
  ════════════════════════════════════════ -->
  <main style="padding:1.5rem;background:#1a1a1a;flex:1">
    <div style="max-width:680px;margin:0 auto">
      <CalendarioReservas
        client:load
        negocioId={negocioId}
        clienteId={user.id}
        servicios={servicios ?? []}
        tasaBcvInicial={tasaBcv}
      />
    </div>
  </main>

</LayoutBase>

