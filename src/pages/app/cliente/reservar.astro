---
import LayoutBase from '../../../layouts/LayoutBase.astro';
import { supabase } from '../../../lib/supabase.js';
import { getSession } from '../../../lib/session.js';
import BookingFlow from '../../../islands/BookingFlow.jsx';

// ── Validación de sesión ──────────────────────────────────────────────────────
const { user, perfil, token } = await getSession(Astro.request);
if (!user) return Astro.redirect('/');

// ── Parámetro de URL ──────────────────────────────────────────────────────────
const negocioId = Astro.url.searchParams.get('id');
if (!negocioId) return Astro.redirect('/app/cliente/buscar');

// ── Consultas paralelas SSR ───────────────────────────────────────────────────
const [
  { data: negocio, error: negocioError },
  { data: servicios },
  { data: configData }
] = await Promise.all([
  supabase
    .from('negocios')
    .select('id, name, address, categoria, descripcion, telefono')
    .eq('id', negocioId)
    .single(),
  supabase
    .from('servicios')
    .select('id, nombre, duracion_min, precio_usd, precio_bs')
    .eq('negocio_id', negocioId)
    .order('precio_usd', { ascending: true }),
  supabase
    .from('configuracion_sistema')
    .select('tasa_bcv')
    .eq('id', 1)
    .maybeSingle()
]);

const tasaBcv = configData?.tasa_bcv ? parseFloat(configData.tasa_bcv) : 40.00;

if (negocioError || !negocio) return Astro.redirect('/app/cliente/buscar');
---

<LayoutBase
  title={`Reservar en ${negocio.name} — CHIKILUKY`}
  description={`Agenda tu cita en ${negocio.name}, ${negocio.address ?? 'Caracas'}.`}
>

  <!-- ═══════════════════════════════════════
       HEADER
  ════════════════════════════════════════ -->
  <header style="position:sticky;top:0;z-index:40;display:flex;align-items:center;justify-content:space-between;padding:0.9rem 1.5rem;background:rgba(10,10,10,0.95);backdrop-filter:blur(14px);border-bottom:1px solid #262626">
    <a href="/app/cliente/buscar" style="text-decoration:none">
      <span class="brand-text" style="font-size:1.1rem;color:#ba8f57">CHIKILUKY</span> 
      <span style="font-family:'Montserrat',sans-serif;font-weight:300;font-style:normal;font-size:0.6rem;color:#555;letter-spacing:0.1em;text-transform:uppercase">.app</span>
    </a>
    <nav style="display:flex;align-items:center;gap:0.4rem">
      {perfil && (
        <div style="display:flex;align-items:center;gap:0.45rem;padding:0.35rem 0.75rem;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.05);border-radius:0px;margin-right:0.2rem">
          <span style="width:6px;height:6px;background:#ba8f57;border-radius:50%;box-shadow:0 0 4px #ba8f57"></span>
          <span style="font-family:'Urbanist',sans-serif;font-size:0.76rem;color:#eee;font-weight:700;letter-spacing:0.02em">{perfil.full_name}</span>
        </div>
      )}
      {perfil && ['experto','administrador'].includes(perfil.role) && (
        <a href="/app/experto/escritorio" style="font-family:'Urbanist',sans-serif;font-size:0.8rem;font-weight:600;color:#a3a3a3;text-decoration:none;padding:0.35rem 0.75rem" onmouseover="this.style.color='#ba8f57'" onmouseout="this.style.color='#a3a3a3'">Panel Pro</a>
      )}
      <a href="/app/cliente/buscar" style="font-family:'Urbanist',sans-serif;font-size:0.8rem;font-weight:600;color:#a3a3a3;text-decoration:none;padding:0.35rem 0.75rem" onmouseover="this.style.color='#ba8f57'" onmouseout="this.style.color='#a3a3a3'">← Buscar</a>
      <span style="color:#262626;margin:0 0.2rem">|</span>
      <a href="/api/auth/logout" style="font-family:'Urbanist',sans-serif;font-size:0.76rem;font-weight:700;color:#ba8f57;border:1px solid rgba(186,143,87,0.25);padding:0.35rem 0.9rem;border-radius:0px;text-decoration:none" onmouseover="this.style.background='rgba(186,143,87,0.06)'" onmouseout="this.style.background='transparent'">Salir</a>
    </nav>
  </header>

  <!-- ═══════════════════════════════════════
       FICHA DEL NEGOCIO (SSR estático)
  ════════════════════════════════════════ -->
  <section style="padding:2.5rem 1.5rem 2rem;background:#0a0a0a;border-bottom:1px solid #1a1a1a">
    <div style="max-width:680px;margin:0 auto">

      <!-- Badge categoría -->
      <span style="
        display:inline-block;
        font-family:'Urbanist',sans-serif;font-size:0.68rem;font-weight:900;
        letter-spacing:0.08em;text-transform:uppercase;
        color:#ba8f57;background:rgba(186,143,87,0.06);
        border:1px solid rgba(186,143,87,0.15);
        padding:0.25rem 0.65rem;border-radius:0px;margin-bottom:0.75rem;
      ">
        {negocio.categoria ?? 'Salón'}
      </span>

      <h1 style="font-family:'Urbanist',sans-serif;font-weight:900;font-size:clamp(1.4rem,4vw,2rem);color:#fff;margin:0 0 0.4rem 0;text-transform:uppercase;letter-spacing:0.02em">
        {negocio.name}
      </h1>

      {negocio.address && (
        <p style="font-family:'Lato',sans-serif;font-size:0.82rem;color:#737373;margin:0;display:flex;align-items:center;gap:0.35rem">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#ba8f57" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          {negocio.address}
        </p>
      )}
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       ISLA DE PREACT — Calendario interactivo
  ════════════════════════════════════════ -->
  <main style="padding:2.5rem 1.5rem 5rem;background:#050505;flex:1">
    <div style="max-width:680px;margin:0 auto">
      <BookingFlow
        client:load
        negocioId={negocioId}
        clienteId={user.id}
        servicios={servicios ?? []}
        tasaBcvInicial={tasaBcv}
        token={token}
        categoria={negocio.categoria}
      />
    </div>
  </main>

</LayoutBase>
