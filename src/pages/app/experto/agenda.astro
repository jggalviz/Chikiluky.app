---
import LayoutBase from '../../../layouts/LayoutBase.astro';
import { supabase } from '../../../lib/supabase.js';
import { getSession } from '../../../lib/session.js';

const { user, perfil } = await getSession(Astro.request);
if (!user) return Astro.redirect('/');
if (!perfil || !['experto', 'administrador'].includes(perfil.role)) {
  return Astro.redirect('/app/cliente/buscar');
}

// ── Consulta de citas del día con datos del cliente ───────────────────────────
const hoyInicio = new Date();
hoyInicio.setHours(0, 0, 0, 0);
const hoyFin = new Date();
hoyFin.setHours(23, 59, 59, 999);

const { data: citas, error: citasError } = await supabase
  .from('citas')
  .select(`
    id,
    start_time,
    end_time,
    status,
    price_usd,
    price_bs,
    servicio,
    cliente:perfiles!citas_client_id_fkey ( full_name, telefono )
  `)
  .eq('expert_id', user.id)
  .gte('start_time', hoyInicio.toISOString())
  .lte('start_time', hoyFin.toISOString())
  .order('start_time', { ascending: true });

// ── Helpers de formato ────────────────────────────────────────────────────────
function formatHora(iso: string): string {
  return new Date(iso).toLocaleTimeString('es-VE', {
    hour: '2-digit', minute: '2-digit', hour12: true,
  });
}

function formatFecha(): string {
  return new Date().toLocaleDateString('es-VE', {
    weekday: 'long', day: 'numeric', month: 'long',
  });
}

const totalUSD = citas?.reduce((s, c) => s + (c.price_usd ?? 0), 0) ?? 0;
const totalBs  = citas?.reduce((s, c) => s + (c.price_bs  ?? 0), 0) ?? 0;

const badgeStyle: Record<string, string> = {
  pendiente:  'background:transparent;border:1px solid #ba8f57;color:#ba8f57',
  confirmada: 'background:rgba(186,143,87,0.18);border:1px solid #ba8f57;color:#d4a96a',
  completada: 'background:rgba(74,222,128,0.1);border:1px solid rgba(74,222,128,0.4);color:#4ade80',
  cancelada:  'background:transparent;border:1px solid #444;color:#555',
};
---

<LayoutBase
  title="Mi Agenda"
  description="Panel de gestión de citas para profesionales de CHIKILUKY."
>

  <!-- ═══════════════════════════════════
       HEADER DE CONTROL
  ══════════════════════════════════════ -->
  <header style="
    position:sticky;top:0;z-index:40;
    display:flex;align-items:center;justify-content:space-between;
    padding:0.9rem 1.5rem;
    background:rgba(17,17,17,0.92);
    backdrop-filter:blur(14px);
    border-bottom:1px solid rgba(186,143,87,0.15);
  ">
    <!-- Isotipo -->
    <a href="/app/experto/agenda" style="display:flex;align-items:center;gap:0.4rem;text-decoration:none">
      <span style="font-family:'Urbanist',sans-serif;font-weight:900;font-size:1.2rem;color:#ba8f57;letter-spacing:0.05em">CHIKILUKY</span>
      <span style="font-size:0.6rem;color:#555;letter-spacing:0.1em;text-transform:uppercase">.pro</span>
    </a>

    <!-- Estado + acciones -->
    <div style="display:flex;align-items:center;gap:0.6rem">
      <span style="width:8px;height:8px;background:#4ade80;border-radius:50%;display:inline-block;box-shadow:0 0 6px #4ade8088"></span>

      <a href="/app/experto/escritorio"
         style="font-family:'Urbanist',sans-serif;font-size:0.82rem;font-weight:700;color:#ba8f57;text-decoration:none;letter-spacing:0.02em">
        Escritorio
      </a>

      <span style="color:#333">|</span>

      <a href="/api/auth/logout"
         style="font-family:'Urbanist',sans-serif;font-size:0.78rem;font-weight:700;color:#ba8f57;border:1px solid rgba(186,143,87,0.35);padding:0.35rem 0.9rem;border-radius:9999px;text-decoration:none;letter-spacing:0.03em"
         onmouseover="this.style.background='rgba(186,143,87,0.1)'"
         onmouseout="this.style.background='transparent'">
        Salir
      </a>
    </div>
  </header>

  <!-- ═══════════════════════════════════
       RESUMEN DEL DÍA
  ══════════════════════════════════════ -->
  <section style="padding:2rem 1.5rem 1rem;background:#111;border-bottom:1px solid rgba(186,143,87,0.1)">
    <div style="max-width:760px;margin:0 auto">
      <p style="font-size:0.7rem;letter-spacing:0.16em;color:#ba8f57;text-transform:uppercase;margin-bottom:0.3rem">Agenda de hoy</p>
      <h1 style="font-family:'Urbanist',sans-serif;font-weight:900;font-size:clamp(1.3rem,3.5vw,1.9rem);color:#fff;margin-bottom:1.5rem;text-transform:capitalize">
        {formatFecha()}
      </h1>

      <!-- Stats rápidas -->
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.75rem">
        <div style="background:#1a1a1a;border:1px solid rgba(186,143,87,0.18);border-radius:0.75rem;padding:1rem;text-align:center">
          <p style="font-family:'Urbanist',sans-serif;font-weight:900;font-size:1.8rem;color:#ba8f57;margin:0">{citas?.length ?? 0}</p>
          <p style="font-family:'Lato',sans-serif;font-size:0.72rem;color:#666;margin-top:0.2rem">Citas hoy</p>
        </div>
        <div style="background:#1a1a1a;border:1px solid rgba(186,143,87,0.18);border-radius:0.75rem;padding:1rem;text-align:center">
          <p style="font-family:'Urbanist',sans-serif;font-weight:900;font-size:1.8rem;color:#ba8f57;margin:0">${totalUSD.toFixed(2)}</p>
          <p style="font-family:'Lato',sans-serif;font-size:0.72rem;color:#666;margin-top:0.2rem">Total USD</p>
        </div>
        <div style="background:#1a1a1a;border:1px solid rgba(186,143,87,0.18);border-radius:0.75rem;padding:1rem;text-align:center">
          <p style="font-family:'Urbanist',sans-serif;font-weight:900;font-size:1.3rem;color:#ba8f57;margin:0">Bs {totalBs.toLocaleString('es-VE', { maximumFractionDigits: 0 })}</p>
          <p style="font-family:'Lato',sans-serif;font-size:0.72rem;color:#666;margin-top:0.2rem">Total Bs</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       TIMELINE DE CITAS
  ══════════════════════════════════════ -->
  <main style="padding:2rem 1.5rem 5rem;background:#1a1a1a;flex:1">
    <div style="max-width:760px;margin:0 auto">

      {citasError && (
        <p style="text-align:center;color:#f87171;font-size:0.9rem;padding:2rem">
          Error al cargar la agenda. Intenta de nuevo.
        </p>
      )}

      {(!citas || citas.length === 0) && !citasError && (
        <div style="text-align:center;padding:4rem 1rem">
          <p style="font-size:2.5rem;margin-bottom:1rem">📅</p>
          <p style="font-family:'Urbanist',sans-serif;font-size:1.1rem;color:#555">
            No hay citas programadas para hoy.
          </p>
          <p style="font-family:'Lato',sans-serif;font-size:0.83rem;color:#444;margin-top:0.5rem">
            Comparte tu link de reserva para recibir citas online.
          </p>
        </div>
      )}

      <!-- Timeline vertical -->
      {citas && citas.length > 0 && (
        <ol style="list-style:none;padding:0;margin:0;position:relative">

          <!-- Línea vertical continua -->
          <div style="position:absolute;left:3.2rem;top:0;bottom:0;width:1px;background:linear-gradient(to bottom,rgba(186,143,87,0.4),rgba(186,143,87,0.05));pointer-events:none"></div>

          {citas.map((cita, idx) => {
            const cliente = Array.isArray(cita.cliente) ? cita.cliente[0] : cita.cliente;
            const waLink  = cliente?.telefono
              ? `https://wa.me/58${cliente.telefono.replace(/\D/g, '').slice(-10)}`
              : null;
            const estado  = cita.status ?? 'pendiente';
            const badge   = badgeStyle[estado] ?? badgeStyle['pendiente'];

            return (
              <li style="display:flex;gap:1.25rem;margin-bottom:1.5rem;position:relative">

                <!-- Burbuja de hora -->
                <div style="flex-shrink:0;width:6rem;text-align:right;padding-top:0.85rem">
                  <time style="font-family:'Urbanist',sans-serif;font-weight:700;font-size:0.95rem;color:#ba8f57">
                    {formatHora(cita.start_time)}
                  </time>
                  {cita.end_time && (
                    <p style="font-family:'Lato',sans-serif;font-size:0.68rem;color:#444;margin-top:0.1rem">
                      → {formatHora(cita.end_time)}
                    </p>
                  )}
                </div>

                <!-- Nodo del timeline -->
                <div style="flex-shrink:0;display:flex;align-items:flex-start;padding-top:1rem">
                  <div style={`width:10px;height:10px;border-radius:50%;border:2px solid #ba8f57;${estado === 'confirmada' ? 'background:#ba8f57' : 'background:#1a1a1a'}`}></div>
                </div>

                <!-- Tarjeta de la cita -->
                <div style="flex:1;background:#111;border:1px solid rgba(186,143,87,0.18);border-radius:0.875rem;padding:1.1rem 1.25rem;transition:border-color 0.2s"
                     onmouseover="this.style.borderColor='rgba(186,143,87,0.45)'"
                     onmouseout="this.style.borderColor='rgba(186,143,87,0.18)'">

                  <!-- Top row: cliente + badge -->
                  <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;flex-wrap:wrap;margin-bottom:0.6rem">
                    <div style="display:flex;align-items:center;gap:0.5rem">
                      <div style="width:32px;height:32px;background:rgba(186,143,87,0.12);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.85rem;flex-shrink:0">
                        👤
                      </div>
                      <div>
                        <p style="font-family:'Urbanist',sans-serif;font-weight:700;font-size:0.95rem;color:#fff;margin:0;line-height:1.2">
                          {cliente?.full_name ?? 'Cliente'}
                        </p>
                        {waLink && (
                          <a href={waLink} target="_blank" rel="noopener"
                             style="font-family:'Lato',sans-serif;font-size:0.72rem;color:#4ade80;text-decoration:none;display:inline-flex;align-items:center;gap:0.25rem">
                            💬 WhatsApp
                          </a>
                        )}
                      </div>
                    </div>

                    <!-- Badge de estado -->
                    <span style={`font-family:'Urbanist',sans-serif;font-size:0.67rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;padding:0.2rem 0.65rem;border-radius:9999px;${badge}`}>
                      {estado}
                    </span>
                  </div>

                  <!-- Servicio -->
                  {cita.servicio && (
                    <p style="font-family:'Lato',sans-serif;font-size:0.83rem;color:#888;margin:0 0 0.75rem;padding:0.4rem 0.75rem;background:rgba(255,255,255,0.03);border-radius:0.4rem;border-left:2px solid rgba(186,143,87,0.4)">
                      ✂️ {cita.servicio}
                    </p>
                  )}

                  <!-- Montos bimonetarios -->
                  <div style="display:flex;gap:1rem;flex-wrap:wrap">
                    <div style="display:flex;align-items:center;gap:0.35rem">
                      <span style="font-size:0.7rem;color:#555;font-family:'Lato',sans-serif">USD</span>
                      <span style="font-family:'Urbanist',sans-serif;font-weight:800;font-size:1.05rem;color:#ba8f57">
                        ${(cita.price_usd ?? 0).toFixed(2)}
                      </span>
                    </div>
                    <div style="display:flex;align-items:center;gap:0.35rem">
                      <span style="font-size:0.7rem;color:#555;font-family:'Lato',sans-serif">Bs</span>
                      <span style="font-family:'Urbanist',sans-serif;font-weight:700;font-size:0.95rem;color:#888">
                        {(cita.price_bs ?? 0).toLocaleString('es-VE', { maximumFractionDigits: 2 })}
                      </span>
                    </div>
                  </div>
                </div>
              </li>
            );
          })}
        </ol>
      )}
    </div>
  </main>

</LayoutBase>

<style>
  @media (min-width: 640px) {
    .sm-show { display: inline-flex !important; }
  }
</style>
