---
import LayoutBase from '../../../layouts/LayoutBase.astro';
import { supabase } from '../../../lib/supabase.js';
import FormularioServicio from '../../../islands/FormularioServicio.jsx';
import { convertirRefABs } from '../../../utils/currency.js';

// ── Validación de sesión y rol ────────────────────────────────────────────────
const authHeader = Astro.request.headers.get('cookie') ?? '';
const token = authHeader.match(/sb-access-token=([^;]+)/)?.[1];

const { data: { user } } = token
  ? await supabase.auth.getUser(token)
  : { data: { user: null } };

if (!user) return Astro.redirect('/');

const { data: perfil } = await supabase
  .from('perfiles')
  .select('full_name, role')
  .eq('id', user.id)
  .single();

if (!perfil || !['experto', 'administrador'].includes(perfil.role)) {
  return Astro.redirect('/app/cliente/buscar');
}

// ── Obtener negocio vinculado al experto ──────────────────────────────────────
const { data: negocio } = await supabase
  .from('negocios')
  .select('id, name')
  .eq('owner_id', user.id)
  .single();

// ── Procesar POST del formulario (SSR nativo) ─────────────────────────────────
let formError  = '';
let formExito  = false;

if (Astro.request.method === 'POST' && negocio) {
  const form       = await Astro.request.formData();
  const accion     = form.get('_accion');

  if (accion === 'crear') {
    const nombre      = String(form.get('nombre')       ?? '').trim();
    const duracion    = parseInt(String(form.get('duracion')   ?? '60'));
    const precio_usd  = parseFloat(String(form.get('precio_usd') ?? '0'));
    const precio_bs   = parseFloat(String(form.get('precio_bs')  ?? '0'));

    if (!nombre || isNaN(precio_usd) || precio_usd <= 0) {
      formError = 'Nombre y precio en USD son requeridos.';
    } else {
      const { error } = await supabase.from('servicios').insert({
        negocio_id:   negocio.id,
        nombre,
        duracion_min: isNaN(duracion) ? 60 : duracion,
        precio_usd,
        precio_bs:    isNaN(precio_bs) ? 0 : precio_bs,
      });
      if (error) formError = error.message;
      else formExito = true;
    }
  }

  if (accion === 'eliminar') {
    const servicioId = String(form.get('servicio_id') ?? '');
    if (servicioId) {
      await supabase
        .from('servicios')
        .delete()
        .eq('id', servicioId)
        .eq('negocio_id', negocio.id); // RLS extra por negocio
    }
  }

  // POST-redirect-GET para evitar resubmit
  if (!formError) return Astro.redirect('/app/experto/precios');
}

// ── Listar servicios actuales ─────────────────────────────────────────────────
const { data: servicios } = negocio
  ? await supabase
      .from('servicios')
      .select('id, nombre, duracion_min, precio_usd, precio_bs')
      .eq('negocio_id', negocio.id)
      .order('precio_usd', { ascending: true })
  : { data: [] };

// ── Obtener tasa BCV activa ──────────────────────────────────────────────────
const { data: configData } = await supabase
  .from('configuracion_sistema')
  .select('tasa_bcv')
  .eq('id', 1)
  .maybeSingle();
const tasaBcv = configData?.tasa_bcv ? parseFloat(configData.tasa_bcv) : 40.00;
---

<LayoutBase
  title="Gestión de Tarifas — CHIKILUKY Pro"
  description="Configura los servicios y precios de tu negocio en CHIKILUKY."
>

  <header style="position:sticky;top:0;z-index:40;display:flex;align-items:center;justify-content:space-between;padding:0.9rem 1.5rem;background:rgba(10,10,10,0.95);backdrop-filter:blur(14px);border-bottom:1px solid #262626">
    <a href="/app/experto/escritorio" style="text-decoration:none">
      <span class="brand-text" style="font-size:1.1rem;color:#ba8f57">CHIKILUKY</span> 
      <span style="font-family:'Montserrat',sans-serif;font-weight:300;font-style:normal;font-size:0.6rem;color:#555;letter-spacing:0.1em;text-transform:uppercase">.pro</span>
    </a>
    <nav style="display:flex;align-items:center;gap:0.4rem">
      <a href="/app/experto/escritorio" style="font-family:'Urbanist',sans-serif;font-size:0.8rem;font-weight:600;color:#a3a3a3;text-decoration:none;padding:0.35rem 0.75rem" onmouseover="this.style.color='#ba8f57'" onmouseout="this.style.color='#a3a3a3'">Escritorio</a>
      <a href="/app/experto/agenda" style="font-family:'Urbanist',sans-serif;font-size:0.8rem;font-weight:600;color:#a3a3a3;text-decoration:none;padding:0.35rem 0.75rem" onmouseover="this.style.color='#ba8f57'" onmouseout="this.style.color='#a3a3a3'">Agenda</a>
      <a href="/app/experto/precios" style="font-family:'Urbanist',sans-serif;font-size:0.8rem;font-weight:700;color:#ba8f57;text-decoration:none;padding:0.35rem 0.75rem;border-radius:0px;background:rgba(186,143,87,0.06);border:1px solid rgba(186,143,87,0.15)">Tarifas</a>
      <a href="/app/experto/pagos" style="font-family:'Urbanist',sans-serif;font-size:0.8rem;font-weight:600;color:#a3a3a3;text-decoration:none;padding:0.35rem 0.75rem" onmouseover="this.style.color='#ba8f57'" onmouseout="this.style.color='#a3a3a3'">Pagos</a>
      <a href="/app/experto/soporte" style="font-family:'Urbanist',sans-serif;font-size:0.8rem;font-weight:600;color:#a3a3a3;text-decoration:none;padding:0.35rem 0.75rem" onmouseover="this.style.color='#ba8f57'" onmouseout="this.style.color='#a3a3a3'">Soporte</a>
      <span style="color:#262626;margin:0 0.2rem">|</span>
      <a href="/api/auth/logout" style="font-family:'Urbanist',sans-serif;font-size:0.76rem;font-weight:700;color:#ba8f57;border:1px solid rgba(186,143,87,0.25);padding:0.35rem 0.9rem;border-radius:0px;text-decoration:none" onmouseover="this.style.background='rgba(186,143,87,0.06)'" onmouseout="this.style.background='transparent'">Salir</a>
    </nav>
  </header>

  <main style="padding:2.5rem 1.5rem 5rem;background:#050505;flex:1">
    <div style="max-width:680px;margin:0 auto">

      <!-- Encabezado de sección -->
      <div style="margin-bottom:2.5rem">
        <p style="font-size:0.68rem;font-family:'Urbanist',sans-serif;font-weight:bold;letter-spacing:0.16em;color:#ba8f57;text-transform:uppercase;margin-bottom:0.3rem">
          Panel de control
        </p>
        <h1 style="font-family:'Urbanist',sans-serif;font-weight:900;font-size:clamp(1.4rem,4vw,1.9rem);color:#fff;margin:0 0 0.75rem 0;letter-spacing:-0.02em">
          Tarifas y Servicios
        </h1>
        <div style="display:flex;align-items:center;flex-wrap:wrap;gap:0.75rem;margin-top:0.4rem">
          {negocio && (
            <span style="font-family:'Lato',sans-serif;font-size:0.82rem;color:#737373;display:flex;align-items:center;gap:0.35rem">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
              </svg>
              {negocio.name}
            </span>
          )}
          <span style="color:#262626;font-size:0.8rem">|</span>
          <span style="background:rgba(186,143,87,0.06);border:1px solid rgba(186,143,87,0.15);color:#ba8f57;font-family:'Urbanist',sans-serif;font-size:0.72rem;font-weight:700;padding:0.25rem 0.6rem;border-radius:0px;text-transform:uppercase;letter-spacing:0.02em">
            Tasa BCV Oficial: {tasaBcv.toFixed(2)} Bs/$
          </span>
          <span style="color:#262626;font-size:0.8rem">|</span>
          <button
            id="btn-sync-bcv"
            title="Sincronizar tasa oficial del BCV en tiempo real"
            style="
              background: transparent;
              border: 1px solid rgba(186, 143, 87, 0.4);
              color: #ba8f57;
              font-family: 'Urbanist', sans-serif;
              font-size: 0.7rem;
              font-weight: 700;
              padding: 0.25rem 0.75rem;
              border-radius: 0px;
              cursor: pointer;
              display: flex;
              align-items: center;
              gap: 0.35rem;
              transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            "
            onmouseover="this.style.background='rgba(186,143,87,0.06)';this.style.borderColor='#ba8f57'"
            onmouseout="this.style.background='transparent';this.style.borderColor='rgba(186,143,87,0.4)'"
          >
            <span id="sync-icon" style="display:inline-block;transition:transform 0.5s ease">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
              </svg>
            </span>
            Sincronizar BCV
          </button>
        </div>
      </div>

      {!negocio && (
        <div style="background:#0a0a0a;border:1px solid #ef4444;border-radius:0px;padding:1.5rem;text-align:center;margin-bottom:2rem">
          <p style="font-family:'Urbanist',sans-serif;font-size:0.95rem;color:#ef4444;font-weight:900;text-transform:uppercase;letter-spacing:0.02em">
            No tienes un negocio registrado aún
          </p>
          <p style="font-family:'Lato',sans-serif;font-size:0.82rem;color:#737373;margin-top:0.4rem">
            Contacta soporte para vincular tu cuenta a un salón.
          </p>
        </div>
      )}

      {negocio && (
        <>

          <!-- Formulario de Servicio Preact Island (Cálculo en Tiempo Real + Tasa BCV) -->
          <FormularioServicio client:only="preact" tasaBcvInicial={tasaBcv} />

          {formError && (
            <p style="font-family:'Lato',sans-serif;font-size:0.8rem;color:#ef4444;margin-bottom:1.5rem;padding:0.75rem 0.9rem;background:rgba(239,68,68,0.05);border-radius:0px;border-left:2px solid #ef4444">
              {formError}
            </p>
          )}

          <!-- ════════════════════════════════════
               TABLA DE SERVICIOS ACTUALES
          ═════════════════════════════════════ -->
          <section style="margin-top:2.5rem">
            <h2 style="font-family:'Urbanist',sans-serif;font-weight:900;font-size:1rem;color:#fff;margin:0 0 1.25rem 0;display:flex;align-items:center;justify-content:space-between;text-transform:uppercase;letter-spacing:0.04em">
              Servicios publicados
              <span style="font-family:'Lato',sans-serif;font-size:0.78rem;font-weight:400;color:#555;text-transform:none;letter-spacing:0">
                {servicios?.length ?? 0} en total
              </span>
            </h2>

            {(!servicios || servicios.length === 0) ? (
              <div style="background:#0a0a0a;border:1px dashed #262626;border-radius:0px;padding:3rem;text-align:center">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#525252" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin:0 auto 1rem;display:block">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
                <p style="font-family:'Lato',sans-serif;font-size:0.88rem;color:#737373;margin:0">
                  Aún no tienes servicios registrados. Añade el primero usando el formulario de arriba.
                </p>
              </div>
            ) : (
              <div style="display:flex;flex-direction:column;gap:0.6rem">
                {servicios.map((s) => (
                  <div style="
                    display:flex;align-items:center;justify-content:space-between;gap:0.75rem;
                    background:#0a0a0a;
                    border:1px solid #1a1a1a;
                    border-radius:0px;
                    padding:1.1rem 1.3rem;
                    transition:border-color 0.18s;
                  "
                  onmouseover="this.style.borderColor='#404040'"
                  onmouseout="this.style.borderColor='#1a1a1a'">

                    <!-- Info del servicio -->
                    <div style="flex:1;min-width:0">
                      <p style="font-family:'Urbanist',sans-serif;font-weight:900;font-size:0.95rem;color:#fff;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-transform:uppercase;letter-spacing:0.02em">
                        {s.nombre}
                      </p>
                      <p style="font-family:'Lato',sans-serif;font-size:0.72rem;color:#737373;margin:0.25rem 0 0;display:flex;align-items:center;gap:0.35rem">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:#525252">
                          <circle cx="12" cy="12" r="10"></circle>
                          <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        <span>{s.duracion_min} minutos</span>
                      </p>
                    </div>

                    <!-- Precios -->
                    <div style="text-align:right;flex-shrink:0;margin-right:0.5rem">
                      <p style="font-family:'Urbanist',sans-serif;font-weight:900;font-size:1.05rem;color:#ba8f57;margin:0">
                        ${s.precio_usd?.toFixed(2)}
                      </p>
                      <p style="font-family:'Lato',sans-serif;font-size:0.68rem;color:#525252;margin:0.12rem 0 0;text-transform:uppercase;font-weight:bold">
                        {convertirRefABs(s.precio_usd, tasaBcv)}
                      </p>
                    </div>

                    <!-- Eliminar -->
                    <form method="POST" style="flex-shrink:0;margin:0">
                      <input type="hidden" name="_accion" value="eliminar" />
                      <input type="hidden" name="servicio_id" value={s.id} />
                      <button
                        type="submit"
                        title="Eliminar servicio"
                        onclick="return confirm('¿Seguro que deseas eliminar este servicio?')"
                        style="
                          background:transparent;border:1px solid rgba(239,68,68,0.25);
                          color:#ef4444;padding:0.35rem 0.65rem;border-radius:0px;
                          cursor:pointer;font-size:0.74rem;font-weight:bold;transition:all 0.18s;
                        "
                        onmouseover="this.style.background='rgba(239,68,68,0.05)';this.style.borderColor='rgba(239,68,68,0.5)'"
                        onmouseout="this.style.background='transparent';this.style.borderColor='rgba(239,68,68,0.25)'"
                      >
                        ✕
                      </button>
                    </form>
                  </div>
                ))}
              </div>
            )}
          </section>

        </>
      )}

    </div>
  </main>

  <!-- Script interactivo premium de sincronización BCV en tiempo real -->
  <script is:inline>
    const btnSync = document.getElementById('btn-sync-bcv');
    const syncIcon = document.getElementById('sync-icon');

    if (btnSync) {
      btnSync.addEventListener('click', async () => {
        // Deshabilitar botón y animar el icono
        btnSync.disabled = true;
        btnSync.style.opacity = '0.6';
        btnSync.style.cursor = 'not-allowed';
        if (syncIcon) {
          syncIcon.style.animation = 'spin 1s linear infinite';
        }

        try {
          // GET al endpoint del scraper oficial del BCV
          const res = await fetch('/api/update-bcv', { method: 'GET' });
          const data = await res.json();

          if (res.ok && (data.ok || data.tasa_actual)) {
            const tasaNuevaVal = data.tasa_nueva || data.tasa_actual;
            if (data.ok) {
              alert(`✅ ¡Tasa oficial sincronizada con éxito!\n\nTasa anterior: ${data.tasa_anterior ? parseFloat(data.tasa_anterior).toFixed(2) : 'N/A'} Bs\nNueva tasa oficial (bcv.org.ve): ${parseFloat(tasaNuevaVal).toFixed(2)} Bs`);
            } else {
              alert(`⚠️ El sitio del BCV no respondió.\n\nSe mantuvo el último valor de respaldo: ${parseFloat(tasaNuevaVal).toFixed(2)} Bs`);
            }
            window.location.reload();
          } else {
            throw new Error(data.error || 'Error al procesar la sincronización.');
          }
        } catch (err) {
          console.error('Error al sincronizar:', err);
          alert(`❌ Error al sincronizar: ${err.message}`);
        } finally {
          btnSync.disabled = false;
          btnSync.style.opacity = '1';
          btnSync.style.cursor = 'pointer';
          if (syncIcon) {
            syncIcon.style.animation = 'none';
          }
        }
      });
    }
  </script>

  <!-- Animación de rotación global para el spinner -->
  <style is:global>
    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
  </style>

</LayoutBase>
