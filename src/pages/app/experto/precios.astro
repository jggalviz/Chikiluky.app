---
import LayoutBase from '../../../layouts/LayoutBase.astro';
import { supabase } from '../../../lib/supabase.js';
import FormularioServicio from '../../../islands/FormularioServicio.jsx';
import { convertirRefABs } from '../../../utils/currency.js';

// ── Validación de sesión y rol ────────────────────────────────────────────────
const authHeader = Astro.request.headers.get('cookie') ?? '';
const token = authHeader.match(/sb-access-token=([^;]+)/)?.[1];

const { data: { user } } = token
  ? await supabase.auth.getUser(token)
  : { data: { user: null } };

if (!user) return Astro.redirect('/');

const { data: perfil } = await supabase
  .from('perfiles')
  .select('full_name, role')
  .eq('id', user.id)
  .single();

if (!perfil || !['experto', 'administrador'].includes(perfil.role)) {
  return Astro.redirect('/app/cliente/buscar');
}

// ── Obtener negocio vinculado al experto ──────────────────────────────────────
const { data: negocio } = await supabase
  .from('negocios')
  .select('id, name')
  .eq('owner_id', user.id)
  .single();

// ── Procesar POST del formulario (SSR nativo) ─────────────────────────────────
let formError  = '';
let formExito  = false;

if (Astro.request.method === 'POST' && negocio) {
  const form       = await Astro.request.formData();
  const accion     = form.get('_accion');

  if (accion === 'crear') {
    const nombre      = String(form.get('nombre')       ?? '').trim();
    const duracion    = parseInt(String(form.get('duracion')   ?? '60'));
    const precio_usd  = parseFloat(String(form.get('precio_usd') ?? '0'));
    const precio_bs   = parseFloat(String(form.get('precio_bs')  ?? '0'));

    if (!nombre || isNaN(precio_usd) || precio_usd <= 0) {
      formError = 'Nombre y precio en USD son requeridos.';
    } else {
      const { error } = await supabase.from('servicios').insert({
        negocio_id:   negocio.id,
        nombre,
        duracion_min: isNaN(duracion) ? 60 : duracion,
        precio_usd,
        precio_bs:    isNaN(precio_bs) ? 0 : precio_bs,
      });
      if (error) formError = error.message;
      else formExito = true;
    }
  }

  if (accion === 'eliminar') {
    const servicioId = String(form.get('servicio_id') ?? '');
    if (servicioId) {
      await supabase
        .from('servicios')
        .delete()
        .eq('id', servicioId)
        .eq('negocio_id', negocio.id); // RLS extra por negocio
    }
  }

  // POST-redirect-GET para evitar resubmit
  if (!formError) return Astro.redirect('/app/experto/precios');
}

// ── Listar servicios actuales ─────────────────────────────────────────────────
const { data: servicios } = negocio
  ? await supabase
      .from('servicios')
      .select('id, nombre, duracion_min, precio_usd, precio_bs')
      .eq('negocio_id', negocio.id)
      .order('precio_usd', { ascending: true })
  : { data: [] };

// ── Obtener tasa BCV activa ──────────────────────────────────────────────────
const { data: configData } = await supabase
  .from('configuracion_sistema')
  .select('tasa_bcv')
  .eq('id', 1)
  .maybeSingle();
const tasaBcv = configData?.tasa_bcv ? parseFloat(configData.tasa_bcv) : 40.00;
---

<LayoutBase
  title="Gestión de Tarifas"
  description="Configura los servicios y precios de tu negocio en CHIKILUKY."
>

  <!-- ═══════════════════════════════════════
       HEADER
  ════════════════════════════════════════ -->
  <header style="position:sticky;top:0;z-index:40;display:flex;align-items:center;justify-content:space-between;padding:0.9rem 1.5rem;background:rgba(17,17,17,0.92);backdrop-filter:blur(14px);border-bottom:1px solid rgba(186,143,87,0.15)">
    <a href="/app/experto/escritorio" style="text-decoration:none"><span class="brand-text" style="font-size:1.1rem;color:#ba8f57">CHIKILUKY</span> <span style="font-family:'Montserrat',sans-serif;font-weight:300;font-style:normal;font-size:0.6rem;color:#555;letter-spacing:0.1em;text-transform:uppercase">.pro</span></a>
    <nav style="display:flex;align-items:center;gap:0.5rem">
      <a href="/app/experto/escritorio" style="font-family:'Urbanist',sans-serif;font-size:0.8rem;font-weight:600;color:#555;text-decoration:none;padding:0.3rem 0.6rem;border-radius:0.4rem" onmouseover="this.style.color='#ba8f57'" onmouseout="this.style.color='#555'">Escritorio</a>
      <a href="/app/experto/agenda" style="font-family:'Urbanist',sans-serif;font-size:0.8rem;font-weight:600;color:#555;text-decoration:none;padding:0.3rem 0.6rem;border-radius:0.4rem" onmouseover="this.style.color='#ba8f57'" onmouseout="this.style.color='#555'">Agenda</a>
      <a href="/app/experto/precios" style="font-family:'Urbanist',sans-serif;font-size:0.8rem;font-weight:700;color:#ba8f57;text-decoration:none;padding:0.3rem 0.6rem;border-radius:0.4rem;background:rgba(186,143,87,0.08)">Tarifas</a>
      <a href="/app/experto/pagos" style="font-family:'Urbanist',sans-serif;font-size:0.8rem;font-weight:600;color:#555;text-decoration:none;padding:0.3rem 0.6rem;border-radius:0.4rem" onmouseover="this.style.color='#ba8f57'" onmouseout="this.style.color='#555'">Pagos</a>
      <a href="/app/experto/soporte" style="font-family:'Urbanist',sans-serif;font-size:0.8rem;font-weight:600;color:#555;text-decoration:none;padding:0.3rem 0.6rem" onmouseover="this.style.color='#ba8f57'" onmouseout="this.style.color='#555'">Soporte</a>
      <span style="color:#2a2a2a">|</span>
      <a href="/api/auth/logout" style="font-family:'Urbanist',sans-serif;font-size:0.78rem;font-weight:700;color:#ba8f57;border:1px solid rgba(186,143,87,0.35);padding:0.35rem 0.9rem;border-radius:9999px;text-decoration:none" onmouseover="this.style.background='rgba(186,143,87,0.1)'" onmouseout="this.style.background='transparent'">Salir</a>
    </nav>
  </header>

  <main style="padding:2rem 1.5rem 5rem;background:#1a1a1a;flex:1">
    <div style="max-width:680px;margin:0 auto">

      <!-- Encabezado de sección -->
      <div style="margin-bottom:2rem">
        <p style="font-size:0.7rem;letter-spacing:0.16em;color:#ba8f57;text-transform:uppercase;margin-bottom:0.3rem">
          Panel de control
        </p>
        <h1 style="font-family:'Urbanist',sans-serif;font-weight:900;font-size:clamp(1.4rem,4vw,1.9rem);color:#fff;margin:0">
          Tarifas y Servicios
        </h1>
        <div style="display:flex;align-items:center;flex-wrap:wrap;gap:0.75rem;margin-top:0.4rem">
          {negocio && (
            <span style="font-family:'Lato',sans-serif;font-size:0.82rem;color:#777">
              🏢 {negocio.name}
            </span>
          )}
          <span style="color:#333;font-size:0.8rem">|</span>
          <span style="background:rgba(186,143,87,0.08);border:1px solid rgba(186,143,87,0.2);color:#ba8f57;font-family:'Urbanist',sans-serif;font-size:0.72rem;font-weight:700;padding:0.2rem 0.6rem;border-radius:9999px">
            💵 BCV Oficial: {tasaBcv.toFixed(2)} Bs/$
          </span>
          <span style="color:#333;font-size:0.8rem">|</span>
          <button
            id="btn-sync-bcv"
            title="Sincronizar tasa oficial del BCV en tiempo real"
            style="
              background: transparent;
              border: 1px solid rgba(186, 143, 87, 0.4);
              color: #ba8f57;
              font-family: 'Urbanist', sans-serif;
              font-size: 0.7rem;
              font-weight: 700;
              padding: 0.2rem 0.75rem;
              border-radius: 9999px;
              cursor: pointer;
              display: flex;
              align-items: center;
              gap: 0.35rem;
              transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            "
            onmouseover="this.style.background='rgba(186,143,87,0.1)';this.style.borderColor='#ba8f57'"
            onmouseout="this.style.background='transparent';this.style.borderColor='rgba(186,143,87,0.4)'"
          >
            <span id="sync-icon" style="display:inline-block;transition:transform 0.5s ease">🔄</span>
            Sincronizar BCV
          </button>
        </div>
      </div>

      {!negocio && (
        <div style="background:#111;border:1px solid rgba(248,113,113,0.3);border-radius:0.875rem;padding:1.5rem;text-align:center;margin-bottom:2rem">
          <p style="font-family:'Urbanist',sans-serif;font-size:0.95rem;color:#f87171">
            No tienes un negocio registrado aún.
          </p>
          <p style="font-family:'Lato',sans-serif;font-size:0.82rem;color:#666;margin-top:0.4rem">
            Contacta soporte para vincular tu cuenta a un salón.
          </p>
        </div>
      )}

      {negocio && (
        <>

          <!-- Formulario de Servicio Preact Island (Cálculo en Tiempo Real + Tasa BCV) -->
          <FormularioServicio client:only="preact" tasaBcvInicial={tasaBcv} />

          {formError && (
            <p style="font-family:'Lato',sans-serif;font-size:0.8rem;color:#f87171;margin-bottom:1rem;padding:0.6rem 0.9rem;background:rgba(248,113,113,0.08);border-radius:0.4rem;border-left:2px solid #f87171">
              {formError}
            </p>
          )}

          <!-- ════════════════════════════════════
               TABLA DE SERVICIOS ACTUALES
          ═════════════════════════════════════ -->
          <section>
            <h2 style="font-family:'Urbanist',sans-serif;font-weight:800;font-size:1rem;color:#fff;margin:0 0 1rem;display:flex;align-items:center;justify-content:space-between">
              Servicios publicados
              <span style="font-family:'Lato',sans-serif;font-size:0.78rem;font-weight:400;color:#555">
                {servicios?.length ?? 0} en total
              </span>
            </h2>

            {(!servicios || servicios.length === 0) ? (
              <div style="background:#111;border:1px dashed rgba(186,143,87,0.2);border-radius:0.875rem;padding:2.5rem;text-align:center">
                <p style="font-size:1.8rem;margin-bottom:0.75rem">📋</p>
                <p style="font-family:'Lato',sans-serif;font-size:0.88rem;color:#555">
                  Aún no tienes servicios registrados. Añade el primero arriba.
                </p>
              </div>
            ) : (
              <div style="display:flex;flex-direction:column;gap:0.6rem">
                {servicios.map((s) => (
                  <div style="
                    display:flex;align-items:center;justify-content:space-between;gap:0.75rem;
                    background:#111;
                    border:1px solid rgba(186,143,87,0.15);
                    border-radius:0.75rem;
                    padding:1rem 1.25rem;
                    transition:border-color 0.18s;
                  "
                  onmouseover="this.style.borderColor='rgba(186,143,87,0.35)'"
                  onmouseout="this.style.borderColor='rgba(186,143,87,0.15)'">

                    <!-- Info del servicio -->
                    <div style="flex:1;min-width:0">
                      <p style="font-family:'Urbanist',sans-serif;font-weight:700;font-size:0.92rem;color:#fff;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                        {s.nombre}
                      </p>
                      <p style="font-family:'Lato',sans-serif;font-size:0.72rem;color:#555;margin:0.2rem 0 0;display:flex;align-items:center;gap:0.5rem">
                        <span>⏱ {s.duracion_min} min</span>
                      </p>
                    </div>

                    <!-- Precios -->
                    <div style="text-align:right;flex-shrink:0">
                      <p style="font-family:'Urbanist',sans-serif;font-weight:800;font-size:0.95rem;color:#ba8f57;margin:0">
                        ${s.precio_usd?.toFixed(2)}
                      </p>
                      <p style="font-family:'Lato',sans-serif;font-size:0.68rem;color:#777;margin:0.12rem 0 0;text-transform:uppercase;font-weight:700">
                        {convertirRefABs(s.precio_usd, tasaBcv)}
                      </p>
                    </div>

                    <!-- Eliminar -->
                    <form method="POST" style="flex-shrink:0;margin:0">
                      <input type="hidden" name="_accion" value="eliminar" />
                      <input type="hidden" name="servicio_id" value={s.id} />
                      <button
                        type="submit"
                        title="Eliminar servicio"
                        onclick="return confirm('¿Eliminar este servicio?')"
                        style="
                          background:transparent;border:1px solid rgba(248,113,113,0.25);
                          color:#f87171;padding:0.35rem 0.6rem;border-radius:0.5rem;
                          cursor:pointer;font-size:0.8rem;transition:all 0.18s;
                        "
                        onmouseover="this.style.background='rgba(248,113,113,0.1)';this.style.borderColor='rgba(248,113,113,0.5)'"
                        onmouseout="this.style.background='transparent';this.style.borderColor='rgba(248,113,113,0.25)'"
                      >
                        ✕
                      </button>
                    </form>
                  </div>
                ))}
              </div>
            )}
          </section>

        </>
      )}

    </div>
  </main>

  <!-- Script interactivo premium de sincronización BCV en tiempo real -->
  <script is:inline>
    const btnSync = document.getElementById('btn-sync-bcv');
    const syncIcon = document.getElementById('sync-icon');

    if (btnSync) {
      btnSync.addEventListener('click', async () => {
        // Deshabilitar botón y animar el icono
        btnSync.disabled = true;
        btnSync.style.opacity = '0.6';
        btnSync.style.cursor = 'not-allowed';
        if (syncIcon) {
          syncIcon.style.animation = 'spin 1s linear infinite';
        }

        try {
          // GET al endpoint de sincronización
          const res = await fetch('/api/sync-bcv', { method: 'GET' });
          const data = await res.json();

          if (res.ok && data.ok) {
            // Recargar la página con éxito
            alert(`✅ ¡Tasa sincronizada con éxito!\n\nTasa anterior: ${data.tasa_anterior ? data.tasa_anterior.toFixed(2) : 'N/A'} Bs\nNueva tasa oficial: ${data.tasa_nueva.toFixed(2)} Bs`);
            window.location.reload();
          } else {
            throw new Error(data.error || 'Error al procesar la sincronización.');
          }
        } catch (err) {
          console.error('Error al sincronizar:', err);
          alert(`❌ Error al sincronizar: ${err.message}`);
        } finally {
          btnSync.disabled = false;
          btnSync.style.opacity = '1';
          btnSync.style.cursor = 'pointer';
          if (syncIcon) {
            syncIcon.style.animation = 'none';
          }
        }
      });
    }
  </script>

  <!-- Animación de rotación global para el spinner -->
  <style is:global>
    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
  </style>

</LayoutBase>
