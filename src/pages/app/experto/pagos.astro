                  <input type="text" name={prefix+f2} value={get(mid, prefix==='p_'?'principal':'secundario', f2)} placeholder={ph2}
                    style="width:100%;background:#1a1a1a;border:1px solid rgba(186,143,87,0.2);border-radius:0.4rem;padding:0.55rem 0.7rem;color:#fff;font-family:'Lato',sans-serif;font-size:0.83rem;outline:none;box-sizing:border-box"
                    onfocus="this.style.borderColor='#ba8f57'" onblur="this.style.borderColor='rgba(186,143,87,0.2)'"/></div>
              </div>
            </div>
          ))}
          <button type="submit" style="width:100%;padding:0.65rem;background:#ba8f57;border:none;border-radius:0.5rem;color:#1a1a1a;font-family:'Urbanist',sans-serif;font-weight:800;font-size:0.88rem;cursor:pointer">Actualizar {title}</button>
        </form>
      </section>
    ))}

  </div>
  </main>
</LayoutBase>

<script>
  // Toggle visual de los pills (sincroniza el checkbox oculto)
  function togglePill(id) {
    const cb   = document.getElementById('tog-' + id);
    const pill = document.getElementById('pill-' + id);
    const dot  = pill.querySelector('div');
    cb.checked = !cb.checked;
    pill.style.background = cb.checked ? '#ba8f57' : '#333';
    dot.style.left        = cb.checked ? '23px' : '3px';
  }
  window.togglePill = togglePill;
</script>
