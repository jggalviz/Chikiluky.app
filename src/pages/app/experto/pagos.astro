---
import LayoutBase from '../../../layouts/LayoutBase.astro';
import { createClient } from '@supabase/supabase-js';
import { getSession } from '../../../lib/session.js';

let { user, perfil } = await getSession(Astro.request);

if (import.meta.env.DEV && !user) {
  user = { id: 'b8001275-5cbe-47aa-bf4d-01193837063a', email: 'barberia@chikiluky.app' };
  perfil = { full_name: 'VIP Studio Expert', role: 'experto' };
} else {
  if (!user) return Astro.redirect('/');
  if (!perfil || !['experto','administrador'].includes(perfil.role))
    return Astro.redirect('/app/cliente/buscar');
}

const cookies = Astro.request.headers.get('cookie') ?? '';
const token   = cookies.match(/sb-access-token=([^;]+)/)?.[1];

const sb = createClient(
  import.meta.env.SUPABASE_URL ?? import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_ANON_KEY ?? import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  {
    global: {
      headers: token ? { Authorization: `Bearer ${token}` } : {},
    },
    auth: {
      persistSession: false,
    },
  }
);

const { data: negocio, error: negocioError } = await sb.from('negocios').select('id, name, config')
  .eq('owner_id', user.id).single();

let formExito = '';
let formError = '';

if (Astro.request.method === 'POST' && negocio) {
  const f      = await Astro.request.formData();
  const metodo = String(f.get('_metodo') ?? '');
  const activo = f.has('activo');
  const cfg    = negocio.config ?? {};
  const pagos  = cfg.pagos ?? {};

  if (metodo === 'reserva_sin_pago') {
    pagos.reserva_sin_pago = { activo };

  } else if (metodo === 'efectivo') {
    pagos.efectivo = { activo, acepta_usd: f.get('acepta_usd') === 'on', acepta_bs: f.get('acepta_bs') === 'on' };

  } else if (['pago_movil','zelle','paypal','zinli','binance_pay'].includes(metodo)) {
    const prev = pagos[metodo] ?? {};
    const fields = {
      pago_movil:   ['banco','telefono','cedula','nombre'],
      zelle:        ['email','nombre'],
      paypal:       ['email','nombre'],
      zinli:        ['telefono','nombre'],
      binance_pay:  ['pay_id','nombre'],
    }[metodo];

    const principal  = Object.fromEntries(fields.map(k => [k, String(f.get(`p_${k}`) ?? prev.principal?.[k] ?? '')]));
    const secundario = Object.fromEntries(fields.map(k => [k, String(f.get(`s_${k}`) ?? prev.secundario?.[k] ?? '')]));
    pagos[metodo] = { activo, principal, secundario };
  }

  const { error } = await sb.from('negocios')
    .update({ config: { ...cfg, pagos } })
    .eq('id', negocio.id);

  if (!error && ['efectivo', 'pago_movil', 'zelle'].includes(metodo)) {
    const updateData = { id: user.id };
    if (metodo === 'efectivo') {
      updateData.efectivo_activo = activo;
    } else if (metodo === 'pago_movil') {
      const pm = pagos.pago_movil ?? {};
      updateData.pago_movil_activo = activo;
      updateData.pago_movil_banco = pm.principal?.banco ?? '';
      updateData.pago_movil_telefono = pm.principal?.telefono ?? '';
      updateData.pago_movil_cedula = pm.principal?.cedula ?? '';
    } else if (metodo === 'zelle') {
      const zl = pagos.zelle ?? {};
      updateData.zelle_activo = activo;
      updateData.zelle_correo = zl.principal?.email ?? '';
      updateData.zelle_titular = zl.principal?.nombre ?? '';
    }

    const { error: syncError } = await sb
      .from('perfiles_profesionales')
      .upsert(updateData);
    if (syncError) {
      console.error('Error syncing perfiles_profesionales:', syncError);
    }
  }

  if (error) formError = error.message;
  else { formExito = metodo; return Astro.redirect('/app/experto/pagos?ok=' + metodo); }
}

// Leer estado guardado
const pagos = negocio?.config?.pagos ?? {};
const ok    = Astro.url.searchParams.get('ok') ?? '';

function get(m, sub, k) { return pagos[m]?.[sub]?.[k] ?? ''; }
function isOn(m) { return pagos[m]?.activo ?? false; }
---

<LayoutBase title="Métodos de Pago" description="Configura cómo recibes pagos en CHIKILUKY.">

