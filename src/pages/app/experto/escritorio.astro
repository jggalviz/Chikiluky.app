---
import LayoutBase from '../../../layouts/LayoutBase.astro';
import { createClient } from '@supabase/supabase-js';
import { getSession } from '../../../lib/session.js';

const { user, perfil } = await getSession(Astro.request);
if (!user) return Astro.redirect('/');
if (!perfil || !['experto','administrador'].includes(perfil.role))
  return Astro.redirect('/app/cliente/buscar');

const sb = createClient(
  import.meta.env.SUPABASE_URL ?? import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_ANON_KEY ?? import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
);

// Datos del negocio
const { data: negocio } = await sb.from('negocios')
  .select('id, name, address, categoria, config')
  .eq('owner_id', user.id).single();

// Estadísticas del día
const hoyInicio = new Date(); hoyInicio.setHours(0,0,0,0);
const hoyFin    = new Date(); hoyFin.setHours(23,59,59,999);

const [{ data: citasHoy }, { data: pendientes }, { data: servicios }, { data: todasCitas }] = await Promise.all([
  sb.from('citas').select('id, status, price_usd, price_bs, servicio, start_time')
    .eq('business_id', negocio?.id ?? '')
    .gte('start_time', hoyInicio.toISOString())
    .lte('start_time', hoyFin.toISOString())
    .order('start_time'),

  sb.from('citas').select('id, servicio, start_time, status')
    .eq('business_id', negocio?.id ?? '')
    .in('status', ['pendiente','pendiente_pago'])
    .order('start_time', { ascending: true })
    .limit(5),

  sb.from('servicios').select('id, nombre, precio_usd')
    .eq('negocio_id', negocio?.id ?? ''),

  sb.from('citas').select('price_usd')
    .eq('business_id', negocio?.id ?? '')
    .eq('status', 'completada'),
]);

const ingresosTotalesUSD = (todasCitas ?? []).reduce((s,c) => s + (c.price_usd ?? 0), 0);
const ingresosHoyUSD     = (citasHoy   ?? []).filter(c => c.status !== 'cancelada').reduce((s,c) => s + (c.price_usd ?? 0), 0);

const metodosActivos = Object.entries(negocio?.config?.pagos ?? {})
  .filter(([,v]: any) => v?.activo).length;

function hora(iso: string) {
  return new Date(iso).toLocaleTimeString('es-VE', { hour:'2-digit', minute:'2-digit', hour12:true });
}

const STATUS_LABEL: Record<string,string> = {
  pendiente: '⏳ Pendiente', pendiente_pago: '💳 Por verificar',
  confirmada: '✅ Confirmada', completada: '🏁 Completada', cancelada: '❌ Cancelada',
};
const STATUS_COLOR: Record<string,string> = {
  pendiente: '#ba8f57', pendiente_pago: '#60a5fa',
  confirmada: '#4ade80', completada: '#888', cancelada: '#444',
};
---

<LayoutBase title="Escritorio — CHIKILUKY Pro" description="Panel central del profesional.">

  <header style="position:sticky;top:0;z-index:40;display:flex;align-items:center;justify-content:space-between;padding:0.9rem 1.5rem;background:rgba(17,17,17,0.95);backdrop-filter:blur(14px);border-bottom:1px solid rgba(186,143,87,0.15)">
    <a href="/app/experto/escritorio" style="text-decoration:none"><span class="brand-text" style="font-size:1.1rem;color:#ba8f57">CHIKILUKY</span> <span style="font-family:'Montserrat',sans-serif;font-weight:300;font-style:normal;font-size:0.6rem;color:#555;letter-spacing:0.1em;text-transform:uppercase">.pro</span></a>
    <nav style="display:flex;align-items:center;gap:0.5rem">
      <a href="/app/experto/escritorio" style="font-family:'Urbanist',sans-serif;font-size:0.8rem;font-weight:700;color:#ba8f57;text-decoration:none;padding:0.3rem 0.6rem;border-radius:0.4rem;background:rgba(186,143,87,0.08)">Escritorio</a>
      <a href="/app/experto/agenda" style="font-family:'Urbanist',sans-serif;font-size:0.8rem;font-weight:600;color:#555;text-decoration:none;padding:0.3rem 0.6rem" onmouseover="this.style.color='#ba8f57'" onmouseout="this.style.color='#555'">Agenda</a>
      <a href="/app/experto/precios" style="font-family:'Urbanist',sans-serif;font-size:0.8rem;font-weight:600;color:#555;text-decoration:none;padding:0.3rem 0.6rem" onmouseover="this.style.color='#ba8f57'" onmouseout="this.style.color='#555'">Tarifas</a>
      <a href="/app/experto/pagos" style="font-family:'Urbanist',sans-serif;font-size:0.8rem;font-weight:600;color:#555;text-decoration:none;padding:0.3rem 0.6rem" onmouseover="this.style.color='#ba8f57'" onmouseout="this.style.color='#555'">Pagos</a>
      <a href="/app/experto/soporte" style="font-family:'Urbanist',sans-serif;font-size:0.8rem;font-weight:600;color:#555;text-decoration:none;padding:0.3rem 0.6rem" onmouseover="this.style.color='#ba8f57'" onmouseout="this.style.color='#555'">Soporte</a>
      <span style="color:#2a2a2a">|</span>
      <a href="/api/auth/logout" style="font-family:'Urbanist',sans-serif;font-size:0.78rem;font-weight:700;color:#ba8f57;border:1px solid rgba(186,143,87,0.35);padding:0.35rem 0.9rem;border-radius:9999px;text-decoration:none" onmouseover="this.style.background='rgba(186,143,87,0.1)'" onmouseout="this.style.background='transparent'">Salir</a>
    </nav>
  </header>

  <main style="padding:1.75rem 1.5rem 5rem;background:#1a1a1a;flex:1;min-height:100vh">
  <div style="max-width:680px;margin:0 auto">

    <!-- Saludo -->
    <div style="margin-bottom:2rem">
      <p style="font-size:0.7rem;letter-spacing:0.16em;color:#ba8f57;text-transform:uppercase;margin-bottom:0.2rem">Escritorio</p>
      <h1 style="font-family:'Urbanist',sans-serif;font-weight:900;font-size:clamp(1.4rem,4vw,2rem);color:#fff;margin:0">
        Hola, {perfil.full_name?.split(' ')[0] ?? 'Profesional'} 👋
      </h1>
      {negocio && <p style="font-family:'Lato',sans-serif;font-size:0.85rem;color:#555;margin:0.25rem 0 0">{negocio.name} · {negocio.categoria}</p>}
    </div>

    <!-- ═══ STATS RÁPIDAS ═══ -->
    <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:0.85rem;margin-bottom:1.75rem">
      {[
        ['Citas hoy',          String(citasHoy?.length ?? 0),        '📅'],
        ['Pendientes',         String(pendientes?.length ?? 0),      '⏳'],
        ['Servicios',          String(servicios?.length ?? 0),       '✂️'],
        ['Ingresos totales',   `$${ingresosTotalesUSD.toFixed(0)}`, '💰'],
      ].map(([label, valor, icon]) => (
        <div style="background:#111;border:1px solid rgba(186,143,87,0.18);border-radius:1rem;padding:1.1rem 1.25rem">
          <p style="font-size:1.4rem;margin:0 0 0.3rem">{icon}</p>
          <p style="font-family:'Urbanist',sans-serif;font-weight:900;font-size:1.5rem;color:#fff;margin:0">{valor}</p>
          <p style="font-family:'Lato',sans-serif;font-size:0.75rem;color:#555;margin:0.15rem 0 0">{label}</p>
        </div>
      ))}
    </div>

    <!-- ═══ ACCESOS RÁPIDOS ═══ -->
    <section style="margin-bottom:1.75rem">
      <p style="font-family:'Lato',sans-serif;font-size:0.7rem;color:#555;text-transform:uppercase;letter-spacing:0.12em;margin:0 0 0.75rem">Acceso rápido</p>
      <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:0.75rem">
        {[
          ['/app/experto/agenda',  '📅','Agenda','Ver tus citas de hoy'],
          ['/app/experto/precios', '💲','Tarifas',`${servicios?.length ?? 0} servicios activos`],
          ['/app/experto/pagos',   '💳','Pagos',`${metodosActivos} método(s) activo(s)`],
          ['/app/experto/soporte', '💬','Soporte','Centro de ayuda realtime'],
          ['/app/cliente/buscar',  '🔍','Ver la App','Como la ve el cliente'],
        ].map(([href,icon,title,sub]) => (
          <a href={href} style="display:flex;flex-direction:column;gap:0.3rem;padding:1rem 1.1rem;background:#111;border:1px solid rgba(186,143,87,0.18);border-radius:0.875rem;text-decoration:none;transition:border-color 0.18s"
             onmouseover="this.style.borderColor='#ba8f57'" onmouseout="this.style.borderColor='rgba(186,143,87,0.18)'">
            <span style="font-size:1.4rem">{icon}</span>
            <span style="font-family:'Urbanist',sans-serif;font-weight:800;font-size:0.92rem;color:#fff">{title}</span>
            <span style="font-family:'Lato',sans-serif;font-size:0.75rem;color:#555">{sub}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- ═══ CITAS DE HOY ═══ -->
    <section style="margin-bottom:1.75rem">
      <p style="font-family:'Lato',sans-serif;font-size:0.7rem;color:#555;text-transform:uppercase;letter-spacing:0.12em;margin:0 0 0.75rem">
        Agenda de hoy — {new Date().toLocaleDateString('es-VE',{weekday:'long',day:'numeric',month:'long'})}
      </p>

      {!citasHoy || citasHoy.length === 0 ? (
        <div style="background:#111;border:1px solid rgba(186,143,87,0.12);border-radius:1rem;padding:1.5rem;text-align:center">
          <p style="font-size:2rem;margin:0 0 0.5rem">🌴</p>
          <p style="font-family:'Lato',sans-serif;font-size:0.88rem;color:#555">Sin citas para hoy.</p>
        </div>
      ) : (
        <div style="display:flex;flex-direction:column;gap:0.6rem">
          {citasHoy.map(c => (
            <div style="display:flex;align-items:center;justify-content:space-between;background:#111;border:1px solid rgba(186,143,87,0.15);border-radius:0.75rem;padding:0.85rem 1rem">
              <div>
                <p style="font-family:'Urbanist',sans-serif;font-weight:700;font-size:0.9rem;color:#fff;margin:0">{c.servicio}</p>
                <p style="font-family:'Lato',sans-serif;font-size:0.78rem;color:#666;margin:0.1rem 0 0">{hora(c.start_time)}</p>
              </div>
              <div style="text-align:right">
                <p style="font-family:'Lato',sans-serif;font-size:0.72rem;margin:0" style={`color:${STATUS_COLOR[c.status] ?? '#888'}`}>
                  {STATUS_LABEL[c.status] ?? c.status}
                </p>
                <p style="font-family:'Urbanist',sans-serif;font-weight:700;font-size:0.82rem;color:#ba8f57;margin:0.15rem 0 0">
                  ${(c.price_usd ?? 0).toFixed(2)}
                </p>
              </div>
            </div>
          ))}
          <div style="text-align:right;margin-top:0.3rem">
            <span style="font-family:'Urbanist',sans-serif;font-weight:700;font-size:0.85rem;color:#ba8f57">
              Total del día: ${ingresosHoyUSD.toFixed(2)} USD
            </span>
          </div>
        </div>
      )}
    </section>

    <!-- ═══ POR VERIFICAR (pendiente_pago) ═══ -->
    {pendientes && pendientes.filter(c => c.status === 'pendiente_pago').length > 0 && (
      <section>
        <p style="font-family:'Lato',sans-serif;font-size:0.7rem;color:#60a5fa;text-transform:uppercase;letter-spacing:0.12em;margin:0 0 0.75rem">
          💳 Comprobantes por verificar
        </p>
        <div style="display:flex;flex-direction:column;gap:0.5rem">
          {pendientes.filter(c => c.status === 'pendiente_pago').map(c => (
            <div style="display:flex;align-items:center;justify-content:space-between;background:rgba(96,165,250,0.05);border:1px solid rgba(96,165,250,0.2);border-radius:0.75rem;padding:0.85rem 1rem">
              <div>
                <p style="font-family:'Urbanist',sans-serif;font-weight:700;font-size:0.88rem;color:#fff;margin:0">{c.servicio}</p>
                <p style="font-family:'Lato',sans-serif;font-size:0.75rem;color:#60a5fa;margin:0.1rem 0 0">
                  {new Date(c.start_time).toLocaleDateString('es-VE',{day:'numeric',month:'short'})} · {hora(c.start_time)}
                </p>
              </div>
              <a href="/app/experto/agenda" style="font-family:'Urbanist',sans-serif;font-weight:700;font-size:0.78rem;color:#60a5fa;border:1px solid rgba(96,165,250,0.3);padding:0.3rem 0.75rem;border-radius:9999px;text-decoration:none">
                Revisar
              </a>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Si no tiene negocio -->
    {!negocio && (
      <div style="background:rgba(186,143,87,0.06);border:1px solid rgba(186,143,87,0.25);border-radius:1rem;padding:1.5rem;text-align:center;margin-top:1rem">
        <p style="font-size:2rem;margin:0 0 0.5rem">⚠️</p>
        <p style="font-family:'Urbanist',sans-serif;font-weight:800;font-size:0.95rem;color:#fff;margin:0 0 0.3rem">Tu negocio aún no está vinculado</p>
        <p style="font-family:'Lato',sans-serif;font-size:0.82rem;color:#555">Contacta al administrador para activar tu perfil profesional.</p>
      </div>
    )}

  </div>
  </main>
</LayoutBase>

<script>
  function toggleMenu() {
    const d = document.getElementById('dropdown');
    if (d) d.style.display = d.style.display === 'none' ? 'block' : 'none';
  }
  window.toggleMenu = toggleMenu;
  // Cerrar al click afuera
  document.addEventListener('click', (e) => {
    const w = document.getElementById('menu-wrapper');
    if (w && !w.contains(e.target as Node)) {
      const d = document.getElementById('dropdown');
      if (d) d.style.display = 'none';
    }
  });
</script>
