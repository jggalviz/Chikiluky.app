---
import LayoutBase from '../../../layouts/LayoutBase.astro';
import { createClient } from '@supabase/supabase-js';
import { getSession } from '../../../lib/session.js';
import ProDashboard from '../../../islands/ProDashboard.jsx';

const { user, perfil } = await getSession(Astro.request);
if (!user) return Astro.redirect('/');
if (!perfil || !['experto','administrador'].includes(perfil.role))
  return Astro.redirect('/app/cliente/buscar');

const sb = createClient(
  import.meta.env.SUPABASE_URL ?? import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_ANON_KEY ?? import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
);

// Obtener negocio del experto
const { data: negocio } = await sb.from('negocios')
  .select('id, name, owner_id')
  .eq('owner_id', user.id)
  .single();

// Obtener lista de servicios del negocio para el registro manual
let servicios = [];
if (negocio) {
  const { data: servData } = await sb.from('servicios')
    .select('id, nombre, precio_usd')
    .eq('negocio_id', negocio.id)
    .order('nombre');
  servicios = servData ?? [];
}

// Obtener la tasa cambiaria del BCV
const { data: configData } = await sb.from('configuracion_sistema')
  .select('tasa_bcv')
  .eq('id', 1)
  .maybeSingle();

const tasaBcv = configData?.tasa_bcv ? parseFloat(configData.tasa_bcv) : 40.00;
---

<LayoutBase title="Escritorio — CHIKILUKY Pro" description="Panel central del profesional.">

  <header style="position:sticky;top:0;z-index:40;display:flex;align-items:center;justify-content:space-between;padding:0.9rem 1.5rem;background:rgba(10,10,10,0.95);backdrop-filter:blur(14px);border-bottom:1px solid #262626">
    <a href="/app/experto/escritorio" style="text-decoration:none">
      <span class="brand-text" style="font-size:1.1rem;color:#ba8f57">CHIKILUKY</span> 
      <span style="font-family:'Montserrat',sans-serif;font-weight:300;font-style:normal;font-size:0.6rem;color:#555;letter-spacing:0.1em;text-transform:uppercase">.pro</span>
    </a>
    <nav style="display:flex;align-items:center;gap:0.4rem">
      <a href="/app/experto/escritorio" style="font-family:'Urbanist',sans-serif;font-size:0.8rem;font-weight:700;color:#ba8f57;text-decoration:none;padding:0.35rem 0.75rem;border-radius:0px;background:rgba(186,143,87,0.06);border:1px solid rgba(186,143,87,0.15)">Escritorio</a>
      <a href="/app/experto/agenda" style="font-family:'Urbanist',sans-serif;font-size:0.8rem;font-weight:600;color:#a3a3a3;text-decoration:none;padding:0.35rem 0.75rem" onmouseover="this.style.color='#ba8f57'" onmouseout="this.style.color='#a3a3a3'">Agenda</a>
      <a href="/app/experto/precios" style="font-family:'Urbanist',sans-serif;font-size:0.8rem;font-weight:600;color:#a3a3a3;text-decoration:none;padding:0.35rem 0.75rem" onmouseover="this.style.color='#ba8f57'" onmouseout="this.style.color='#a3a3a3'">Tarifas</a>
      <a href="/app/experto/pagos" style="font-family:'Urbanist',sans-serif;font-size:0.8rem;font-weight:600;color:#a3a3a3;text-decoration:none;padding:0.35rem 0.75rem" onmouseover="this.style.color='#ba8f57'" onmouseout="this.style.color='#a3a3a3'">Pagos</a>
      <a href="/app/experto/soporte" style="font-family:'Urbanist',sans-serif;font-size:0.8rem;font-weight:600;color:#a3a3a3;text-decoration:none;padding:0.35rem 0.75rem" onmouseover="this.style.color='#ba8f57'" onmouseout="this.style.color='#a3a3a3'">Soporte</a>
      <span style="color:#262626;margin:0 0.2rem">|</span>
      <a href="/api/auth/logout" style="font-family:'Urbanist',sans-serif;font-size:0.76rem;font-weight:700;color:#ba8f57;border:1px solid rgba(186,143,87,0.25);padding:0.35rem 0.9rem;border-radius:0px;text-decoration:none" onmouseover="this.style.background='rgba(186,143,87,0.06)'" onmouseout="this.style.background='transparent'">Salir</a>
    </nav>
  </header>

  <main style="padding:2rem 1rem 5rem;background:#050505;flex:1;min-height:calc(100vh - 65px)">
    <div style="max-width:680px;margin:0 auto">
      {negocio ? (
        <ProDashboard
          client:load
          negocio={negocio}
          profesionalId={user.id}
          servicios={servicios}
          tasaBcvInicial={tasaBcv}
          fullName={perfil.full_name}
        />
      ) : (
        <div style={{ background: '#0a0a0a', border: '1px solid #262626', borderRadius: '0px', padding: '3rem 2rem', textAlign: 'center', marginTop: '2rem' }}>
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style={{ color: '#ba8f57', margin: '0 auto 1rem', display: 'block' }}>
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <h2 style={{ fontFamily: "'Urbanist', sans-serif", fontWeight: 900, fontSize: '1.25rem', color: '#fff', margin: '0 0 0.5rem 0', textTransform: 'uppercase', letterSpacing: '0.04em' }}>Tu negocio aún no está vinculado</h2>
          <p style={{ fontFamily: "'Lato', sans-serif", fontSize: '0.82rem', color: '#737373', margin: 0 }}>Por favor, contacta al administrador del sistema para vincular tu perfil profesional con el local correspondiente.</p>
        </div>
      )}
    </div>
  </main>
</LayoutBase>
