---
import LayoutBase from '../../../layouts/LayoutBase.astro';
import Header from '../../../components/Header.astro';
import { supabase } from '../../../lib/supabase.js';
import { getSession } from '../../../lib/session.js';
import GestionEspecialistas from '../../../islands/GestionEspecialistas.jsx';

// ── Validación de sesión y rol ────────────────────────────────────────────────
const { user, perfil } = await getSession(Astro.request);
if (!user) return Astro.redirect('/');

if (!perfil || !['experto', 'administrador'].includes(perfil.role)) {
  return Astro.redirect('/app/cliente/buscar');
}

// ── Obtener negocio vinculado al experto ──────────────────────────────────────
const { data: negocio } = await supabase
  .from('negocios')
  .select('id, name, config')
  .eq('owner_id', user.id)
  .single();
---

<LayoutBase
  title="Gestión de Especialistas — CHIKILUKY Pro"
  description="Administra los especialistas y miembros del equipo de tu salón en CHIKILUKY."
>

  <Header user={user} perfil={perfil} />

  <main style="padding:2.5rem 1.5rem 5rem;background:#050505;flex:1">
    <div style="max-width:680px;margin:0 auto">

      <!-- Encabezado de sección -->
      <div style="margin-bottom:2.5rem">
        <p style="font-size:0.68rem;font-family:'Urbanist',sans-serif;font-weight:bold;letter-spacing:0.16em;color:#ba8f57;text-transform:uppercase;margin-bottom:0.3rem">
          Panel de control
        </p>
        <h1 style="font-family:'Urbanist',sans-serif;font-weight:900;font-size:clamp(1.4rem,4vw,1.9rem);color:#fff;margin:0 0 0.75rem 0;letter-spacing:-0.02em;text-transform:uppercase">
          Equipo de Trabajo
        </h1>
        <div style="display:flex;align-items:center;flex-wrap:wrap;gap:0.75rem;margin-top:0.4rem">
          {negocio && (
            <span style="font-family:'Lato',sans-serif;font-size:0.82rem;color:#737373;display:flex;align-items:center;gap:0.35rem">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
              </svg>
              {negocio.name}
            </span>
          )}
          <span style="color:#262626;font-size:0.8rem">|</span>
          <span style="background:rgba(186,143,87,0.06);border:1px solid rgba(186,143,87,0.15);color:#ba8f57;font-family:'Urbanist',sans-serif;font-size:0.72rem;font-weight:700;padding:0.25rem 0.6rem;border-radius:0px;text-transform:uppercase;letter-spacing:0.02em">
            Plan Activo: {perfil?.plan ?? 'gratis'}
          </span>
        </div>
      </div>

      {!negocio && (
        <div style="background:#0a0a0a;border:1px solid #ef4444;border-radius:0px;padding:1.5rem;text-align:center;margin-bottom:2rem">
          <p style="font-family:'Urbanist',sans-serif;font-size:0.95rem;color:#ef4444;font-weight:900;text-transform:uppercase;letter-spacing:0.02em">
            No tienes un negocio registrado aún
          </p>
          <p style="font-family:'Lato',sans-serif;font-size:0.82rem;color:#737373;margin-top:0.4rem">
            Contacta soporte para vincular tu cuenta a un salón.
          </p>
        </div>
      )}

      {negocio && (
        <GestionEspecialistas
          client:only="preact"
          negocioId={negocio.id}
          configInicial={negocio.config || {}}
          plan={perfil?.plan ?? 'gratis'}
        />
      )}

    </div>
  </main>

</LayoutBase>
