    }
    .compare-table td.plan-col {
      width: 180px;
    }
    .compare-table td.pro-col {
      background: rgba(186, 143, 87, 0.03);
    }
    .compare-val-check {
      color: #BA8F57;
      font-weight: 700;
    }
    .compare-val-cross {
      color: rgba(255, 255, 255, 0.25);
    }
    
    @keyframes soportePulse {
      0% { box-shadow: 0 0 10px rgba(186,143,87,0.25); }
      100% { box-shadow: 0 0 25px rgba(186,143,87,0.55); }
    }
  </style>

  <!-- WIDGET DE SOPORTE FLOTANTE REALTIME (CARGA DIFERIDA DE MÁXIMA VELOCIDAD) -->
  <div id="soporte-container" style="position: fixed; right: 24px; bottom: 24px; z-index: 100;">
    <!-- Botón estático inicial para evitar cargar JS en la ruta crítica -->
    <button
      id="btn-soporte-estatico"
      aria-label="Abrir chat de soporte"
      style="width: 60px; height: 60px; border-radius: 50%; background: #111; border: 2px solid #BA8F57; color: #BA8F57; display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: 0 8px 30px rgba(186,143,87,0.3); transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); animation: soportePulse 3s infinite alternate;"
      onmouseover="this.style.transform='scale(1.08) rotate(5deg)'; this.style.background='#BA8F57'; this.style.color='#000'; this.style.borderColor='#fff';"
      onmouseout="this.style.transform='scale(1) rotate(0deg)'; this.style.background='#111'; this.style.color='#BA8F57'; this.style.borderColor='#BA8F57';"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
      </svg>
    </button>
  </div>

  <script define:vars={{ token }}>
    const btn = document.getElementById('btn-soporte-estatico');
    let loaded = false;

    async function loadChat(openImmediately = false) {
      if (loaded) return;
      loaded = true;
      
      try {
        // Importar dinámicamente Preact y el componente de SoporteFlotante
        const { h, render } = await import('preact');
        const { default: SoporteFlotante } = await import('../islands/SoporteFlotante');
        
        const container = document.getElementById('soporte-container');
        if (container) {
          container.innerHTML = '';
          render(h(SoporteFlotante, { token, isOpenInitial: openImmediately }), container);
        }
      } catch (err) {
        console.error('Error al cargar dinámicamente el chat de soporte:', err);
      }
    }

    if (btn) {
      btn.addEventListener('click', () => loadChat(true), { once: true });
      btn.addEventListener('mouseenter', () => loadChat(false), { once: true });
      btn.addEventListener('touchstart', () => loadChat(false), { once: true, passive: true });
    }

    // Carga en segundo plano tras 4s de inactividad inicial
    if (typeof requestIdleCallback !== 'undefined') {
      requestIdleCallback(() => {
        setTimeout(() => loadChat(false), 4000);
      });
    } else {
      setTimeout(() => loadChat(false), 5000);
    }
  </script>

</LayoutBase>
