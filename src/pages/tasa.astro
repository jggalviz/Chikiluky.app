---
import LayoutBase from '../layouts/LayoutBase.astro';
import { createClient } from '@supabase/supabase-js';
import { convertirRefABs } from '../utils/currency.js';

const sb = createClient(
  import.meta.env.SUPABASE_URL ?? import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_ANON_KEY ?? import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
);

// Obtener la tasa BCV activa en la base de datos
const { data: config } = await sb
  .from('configuracion_sistema')
  .select('tasa_bcv, ultima_actualizacion')
  .eq('id', 1)
  .maybeSingle();

const tasaBcv = config?.tasa_bcv ? parseFloat(config.tasa_bcv) : 40.00;
const ultimaActualizacion = config?.ultima_actualizacion
  ? new Date(config.ultima_actualizacion).toLocaleString('es-VE', {
      timeZone: 'America/Caracas',
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      hour12: true,
    })
  : 'No disponible';

const conversionesComunes = [1, 5, 10, 20, 50, 100, 200, 500];
---

<LayoutBase title="Tasa Oficial BCV">
  <div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem; background: radial-gradient(circle at center, #1b1611 0%, #000000 100%);">
    <div style="width: 100%; max-width: 540px; background: rgba(18, 18, 18, 0.7); border: 1px solid rgba(186, 143, 87, 0.25); border-radius: 1.5rem; padding: 2.5rem; backdrop-filter: blur(20px); box-shadow: 0 24px 50px -10px rgba(0, 0, 0, 0.95); text-align: center; position: relative; overflow: hidden;">
      
      <!-- Sutil resplandor de iluminación de fondo -->
      <div style="position: absolute; top: -50%; left: 50%; transform: translateX(-50%); width: 280px; height: 280px; background: radial-gradient(circle, rgba(186, 143, 87, 0.12) 0%, transparent 70%); pointer-events: none;"></div>

      <!-- Cabecera de Marca -->
      <div style="margin-bottom: 2rem;">
        <span class="brand-text" style="font-family: 'Montserrat', sans-serif; font-weight: 300; font-size: 0.8rem; letter-spacing: 0.35em; color: #ba8f57; display: block; margin-bottom: 0.5rem;">CHIKILUKY</span>
        <h1 style="font-family: 'Oswald', sans-serif; font-weight: 800; font-size: 1.75rem; color: #ffffff; margin: 0; letter-spacing: 0.05em;">Tasa Cambiaria Oficial</h1>
      </div>

      <!-- Insignia de Procedencia de Datos -->
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(186, 143, 87, 0.08); border: 1px solid rgba(186, 143, 87, 0.2); padding: 0.45rem 1.1rem; border-radius: 2rem; margin-bottom: 2.2rem;">
        <span style="font-size: 0.8rem;">🏛️</span>
        <span style="font-family: 'Hanken Grotesk', sans-serif; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; color: #ba8f57; text-transform: uppercase;">BANCO CENTRAL DE VENEZUELA (BCV)</span>
      </div>

      <!-- Bloque Principal de Visualización -->
      <div style="background: rgba(8, 8, 8, 0.6); border: 1px solid rgba(255, 255, 255, 0.04); border-radius: 1.25rem; padding: 2.25rem 2rem; margin-bottom: 2rem; box-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.7);">
        <p style="font-family: 'Hanken Grotesk', sans-serif; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.15em; color: rgba(255, 255, 255, 0.45); text-transform: uppercase; margin-bottom: 0.75rem;">VALOR DEL DOLAR ACTIVO ($REF)</p>
        <p style="font-family: 'Oswald', sans-serif; font-size: 3.6rem; font-weight: 900; color: #ffffff; line-height: 1; margin: 0; letter-spacing: -0.01em;">
          {tasaBcv.toLocaleString('es-VE', { minimumFractionDigits: 4, maximumFractionDigits: 4 })} <span style="font-size: 1.8rem; color: #ba8f57; font-weight: 600; margin-left: 0.15rem;">Bs</span>
        </p>
        
        <div style="width: 40px; height: 1px; background: rgba(186, 143, 87, 0.4); margin: 1.5rem auto;"></div>
        
        <p style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.72rem; color: rgba(255, 255, 255, 0.45); margin: 0;">
          Sincronizado directamente desde el portal oficial:
        </p>
        <p style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.78rem; font-weight: 600; color: #ffffff; margin-top: 0.25rem; text-transform: capitalize;">
          {ultimaActualizacion}
        </p>
      </div>

      <!-- Grilla de Conversiones de Referencia -->
      <div style="text-align: left; margin-bottom: 2.2rem;">
        <h3 style="font-family: 'Oswald', sans-serif; font-size: 0.88rem; color: #ffffff; margin-bottom: 1rem; letter-spacing: 0.05em; border-left: 2px solid #ba8f57; padding-left: 0.6rem; text-transform: uppercase;">
          Tabla de Conversión Rápida
        </h3>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
          {conversionesComunes.map((usd) => (
            <div style="background: rgba(255, 255, 255, 0.015); border: 1px solid rgba(255, 255, 255, 0.03); border-radius: 0.75rem; padding: 0.8rem 1rem; display: flex; justify-content: space-between; align-items: center;">
              <span style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.8rem; font-weight: 700; color: rgba(255, 255, 255, 0.9);">${usd} USD</span>
              <span style="font-family: 'Oswald', sans-serif; font-size: 0.95rem; font-weight: 600; color: #ba8f57;">{convertirRefABs(usd, tasaBcv)}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Fin del Contenedor -->
      
    </div>
  </div>
</LayoutBase>
