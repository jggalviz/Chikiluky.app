---
import LayoutBase from '../../layouts/LayoutBase.astro';
import { createClient } from '@supabase/supabase-js';
import { getSession } from '../../lib/session.js';
import ProDashboard from '../../islands/ProDashboard.jsx';

const { user, perfil } = await getSession(Astro.request);
if (!user) return Astro.redirect('/');
if (!perfil || !['experto','administrador'].includes(perfil.role))
  return Astro.redirect('/app/cliente/buscar');

const sb = createClient(
  import.meta.env.SUPABASE_URL ?? import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_ANON_KEY ?? import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
);

// Obtener negocio del experto
const { data: negocio } = await sb.from('negocios')
  .select('id, name, owner_id')
  .eq('owner_id', user.id)
  .single();

// Si no hay negocio vinculado, redirigimos
if (!negocio) {
  return Astro.redirect('/app/experto/escritorio');
}

// Obtener lista de servicios del negocio para el registro manual
const { data: servicios } = await sb.from('servicios')
  .select('id, nombre, precio_usd')
  .eq('negocio_id', negocio.id)
  .order('nombre');

// Obtener la tasa cambiaria del BCV
const { data: configData } = await sb.from('configuracion_sistema')
  .select('tasa_bcv')
  .eq('id', 1)
  .maybeSingle();

const tasaBcv = configData?.tasa_bcv ? parseFloat(configData.tasa_bcv) : 40.00;
---

<LayoutBase title="Escritorio Pro — CHIKILUKY" description="Panel administrativo del local para profesionales.">
  <!-- CABECERA -->
  <header style="position:sticky;top:0;z-index:40;display:flex;align-items:center;justify-content:space-between;padding:0.9rem 1.5rem;background:rgba(17,17,17,0.95);backdrop-filter:blur(14px);border-bottom:1px solid rgba(186,143,87,0.15)">
    <a href="/pro/dashboard" style="text-decoration:none">
      <span class="brand-text" style="font-size:1.1rem;color:#ba8f57">CHIKILUKY</span> 
      <span style="font-family:'Montserrat',sans-serif;font-weight:300;font-style:normal;font-size:0.6rem;color:#555;letter-spacing:0.1em;text-transform:uppercase">.pro</span>
    </a>
    <nav style="display:flex;align-items:center;gap:0.5rem">
      <a href="/app/experto/escritorio" style="font-family:'Urbanist',sans-serif;font-size:0.8rem;font-weight:600;color:#555;text-decoration:none;padding:0.3rem 0.6rem" onmouseover="this.style.color='#ba8f57'" onmouseout="this.style.color='#555'">Volver Clásico</a>
      <span style="color:#2a2a2a">|</span>
      <a href="/api/auth/logout" style="font-family:'Urbanist',sans-serif;font-size:0.78rem;font-weight:700;color:#ba8f57;border:1px solid rgba(186,143,87,0.35);padding:0.35rem 0.9rem;border-radius:9999px;text-decoration:none" onmouseover="this.style.background='rgba(186,143,87,0.1)'" onmouseout="this.style.background='transparent'">Salir</a>
    </nav>
  </header>

  <main style="padding:1.5rem 1rem 5rem;background:#141414;min-height:calc(100vh - 65px)">
    <div style="max-width:680px;margin:0 auto">
      <ProDashboard
        client:load
        negocio={negocio}
        profesionalId={user.id}
        servicios={servicios ?? []}
        tasaBcvInicial={tasaBcv}
        fullName={perfil.full_name}
      />
    </div>
  </main>
</LayoutBase>
