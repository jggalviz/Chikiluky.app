# ─────────────────────────────────────────────────────────────
# CHIKILUKY.app — Environment Variables
# Copy this file to `.env` and fill in your own values.
# ─────────────────────────────────────────────────────────────

# ── Server-side (SSR pages + API routes) ─────────────────────
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-clave-anonima-aqui

# ── Exposed to the browser (Preact islands) ──────────────────
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu-clave-anonima-aqui

# ── Privileged, server-only (NEVER expose publicly) ──────────
# Required by /api/auth/delete-account and recommended for
# /api/update-bcv so the BCV write bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# ── Shared secret for the BCV sync endpoint (cron/automation) ─
# GET /api/update-bcv?secret=<CRON_SECRET>
# If omitted, the route falls back to a development default.
CRON_SECRET=reemplaza-con-un-secreto-largo-y-aleatorio

